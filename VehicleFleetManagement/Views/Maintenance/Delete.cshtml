@model VehicleFleetManagement.Models.Maintenance
@{
    ViewData["Title"] = $"Delete Maintenance #{Model.MaintenanceId}";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-custom p-4 shadow-sm border-danger border-top border-4">
            <div class="text-center mb-4">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 d-inline-flex mb-2">
                    <i class="bi bi-trash-fill fs-1"></i>
                </div>
                <h3 class="fw-bold text-dark">Confirm Maintenance Record Deletion</h3>
                <p class="text-muted small">Are you sure you want to permanently remove maintenance record #@Model.MaintenanceId?</p>
            </div>

            <div class="bg-light p-3 rounded mb-4">
                <div class="row g-2 small">
                    <div class="col-sm-5 text-muted fw-semibold">Vehicle:</div>
                    <div class="col-sm-7 fw-bold text-primary">@(Model.Vehicle?.RegistrationNumber ?? "N/A")</div>

                    <div class="col-sm-5 text-muted fw-semibold">Service Type:</div>
                    <div class="col-sm-7 fw-bold">@Model.ServiceType</div>

                    <div class="col-sm-5 text-muted fw-semibold">Service Date:</div>
                    <div class="col-sm-7">@Model.ServiceDate.ToString("d")</div>

                    <div class="col-sm-5 text-muted fw-semibold">Invoice Cost:</div>
                    <div class="col-sm-7 fw-bold text-danger">$@Model.Cost.ToString("N2")</div>

                    <div class="col-sm-5 text-muted fw-semibold">Status:</div>
                    <div class="col-sm-7"><span class="badge bg-secondary">@Model.Status</span></div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaintenanceId" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i> Permanently Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
