@model VehicleFleetManagement.Models.Driver
@{
    ViewData["Title"] = "Register Driver";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card card-custom p-4 shadow-sm mb-4">
            <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                <div class="bg-primary text-white rounded-circle p-3 me-3 fs-3">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold" style="color: #172554;">Register New Fleet Driver</h3>
                    <div class="text-muted small">Record driver credentials, government license details, and contact info</div>
                </div>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="FullName" class="form-label fw-semibold small"></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Johnathan Doe" autofocus />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="e.g. jdoe@fleet.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. +1-555-0123" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LicenseNumber" class="form-label fw-semibold small"></label>
                        <input asp-for="LicenseNumber" class="form-control text-uppercase" placeholder="e.g. DL-12345-CA" />
                        <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LicenseExpiryDate" class="form-label fw-semibold small"></label>
                        <input asp-for="LicenseExpiryDate" type="date" class="form-control" />
                        <span asp-validation-for="LicenseExpiryDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Address" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Address" class="form-control" rows="2" placeholder="Full residential street address, city, and state..."></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="JoiningDate" class="form-label fw-semibold small"></label>
                        <input asp-for="JoiningDate" type="date" class="form-control" />
                        <span asp-validation-for="JoiningDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AvailabilityStatus" class="form-label fw-semibold small"></label>
                        <select asp-for="AvailabilityStatus" class="form-select">
                            <option value="Available">Available</option>
                            <option value="OnTrip">On Trip</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <span asp-validation-for="AvailabilityStatus" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Register Driver
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
