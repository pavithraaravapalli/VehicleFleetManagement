@model IEnumerable<VehicleFleetManagement.Models.Driver>
@{
    ViewData["Title"] = "Driver Directory";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    string searchTerm = ViewBag.SearchTerm as string ?? "";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: #172554;">Driver Roster & Credentials</h2>
        <p class="text-muted small mb-0">Total of <strong>@totalCount</strong> authorized drivers registered in the organization</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn text-white shadow-sm" style="background-color: #172554;">
            <i class="bi bi-person-plus me-1"></i> Register New Driver
        </a>
    }
</div>

<!-- Search & Filtering Bar -->
<div class="card card-custom p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-12 col-md-6">
            <label class="form-label small fw-semibold text-muted">Search Driver</label>
            <div class="input-group">
                <span class="input-group-text bg-light text-secondary border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" value="@searchTerm" class="form-control border-start-0" placeholder="Name, License #, Email, or Phone..." />
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4">
            <label class="form-label small fw-semibold text-muted">Availability Status</label>
            <select name="availabilityStatus" class="form-select">
                <option value="">All Statuses</option>
                <!option value="Available" @(selectedStatus == "Available" ? "selected" : "")>Available for Dispatch</!option>
                <!option value="OnTrip" @(selectedStatus == "OnTrip" ? "selected" : "")>On Active Trip</!option>
                <!option value="Inactive" @(selectedStatus == "Inactive" ? "selected" : "")>Inactive / Deactivated</!option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel me-1"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Drivers Table -->
<div class="card card-custom shadow-sm mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Driver Name</th>
                        <th>Contact</th>
                        <th>License #</th>
                        <th>License Expiry</th>
                        <th>Joined</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var d in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@d.DriverId" class="fw-bold text-decoration-none text-primary">
                                        @d.FullName
                                    </a>
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope text-muted me-1"></i> @d.Email</div>
                                    <div class="text-muted small"><i class="bi bi-telephone text-muted me-1"></i> @d.PhoneNumber</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@d.LicenseNumber</span>
                                </td>
                                <td>
                                    <span class="@(d.LicenseExpiryDate < DateTime.UtcNow.AddDays(30) ? "text-danger fw-bold" : "")">
                                        @d.LicenseExpiryDate.ToString("d")
                                    </span>
                                </td>
                                <td>@d.JoiningDate.ToString("d")</td>
                                <td>
                                    @if (d.AvailabilityStatus == "Available")
                                    {
                                        <span class="badge bg-success px-2 py-1"><i class="bi bi-check-circle me-1"></i> Available</span>
                                    }
                                    else if (d.AvailabilityStatus == "OnTrip")
                                    {
                                        <span class="badge bg-primary px-2 py-1"><i class="bi bi-steering-wheel me-1"></i> On Trip</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">@d.AvailabilityStatus</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@d.DriverId" class="btn btn-outline-secondary" title="View Profile & Trips">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@d.DriverId" class="btn btn-outline-primary" title="Edit Driver">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@d.DriverId" class="btn btn-outline-danger" title="Remove / Deactivate">
                                                <i class="bi bi-person-x"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x display-4 d-block mb-2 text-secondary"></i>
                                No drivers found matching the specified search parameters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination Controls -->
@if (totalPages > 1)
{
    <nav aria-label="Driver Page Navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-page="@(currentPage - 1)" 
                   asp-route-searchTerm="@searchTerm" 
                   asp-route-availabilityStatus="@selectedStatus">
                    &laquo; Previous
                </a>
            </li>

            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@p" 
                       asp-route-searchTerm="@searchTerm" 
                       asp-route-availabilityStatus="@selectedStatus">
                        @p
                    </a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-page="@(currentPage + 1)" 
                   asp-route-searchTerm="@searchTerm" 
                   asp-route-availabilityStatus="@selectedStatus">
                    Next &raquo;
                </a>
            </li>
        </ul>
    </nav>
}
