@model VehicleFleetManagement.ViewModels.DriverProfileViewModel
@{
    ViewData["Title"] = $"{Model.FullName} - Professional Profile";
    var isAdmin = User.IsInRole("Admin");
}

<div class="container py-4">
    <!-- Top Breadcrumb & Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-controller="Drivers" asp-action="Index">Drivers</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
            </ol>
        </nav>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Driver"))
            {
                <a asp-controller="Dashboard" asp-action="Driver" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="bi bi-speedometer2 me-1"></i> Back to Workspace
                </a>
            }
            else
            {
                <a asp-controller="Drivers" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Back to Drivers
                </a>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Profile Card: Avatar, Status, Quick Stats -->
        <div class="col-12 col-lg-4">
            <div class="card card-modern p-4 text-center shadow-sm border-0 mb-4">
                
                <!-- Avatar with Upload / Preview -->
                <div class="position-relative d-inline-block mx-auto mb-3">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="@Model.FullName" class="avatar-circle-lg mx-auto" id="profileImagePreview" />
                    }
                    else
                    {
                        <div class="avatar-placeholder-lg mx-auto" id="profilePlaceholder">
                            @((Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "D"))
                        </div>
                        <img src="" alt="Preview" class="avatar-circle-lg mx-auto d-none" id="profileImagePreview" />
                    }
                </div>

                <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-2"><i class="bi bi-person-badge text-primary me-1"></i> Fleet Driver ID: #@Model.DriverId</p>

                <!-- Availability Badge -->
                <div class="mb-3">
                    @if (Model.AvailabilityStatus == "Available")
                    {
                        <span class="badge badge-status badge-available"><i class="bi bi-circle-fill" style="font-size: 6px;"></i> Available</span>
                    }
                    else if (Model.AvailabilityStatus == "OnTrip")
                    {
                        <span class="badge badge-status badge-ontrip"><i class="bi bi-truck"></i> On Active Trip</span>
                    }
                    else if (Model.AvailabilityStatus == "OnLeave")
                    {
                        <span class="badge badge-status badge-onleave"><i class="bi bi-calendar-event"></i> On Leave</span>
                    }
                    else
                    {
                        <span class="badge badge-status badge-unavailable"><i class="bi bi-slash-circle"></i> Unavailable</span>
                    }
                </div>

                <!-- Star Rating Header -->
                <div class="p-3 bg-light rounded-3 mb-3 text-center">
                    <div class="display-6 fw-bold text-dark mb-0">@Model.Rating.ToString("N1")</div>
                    <div class="star-rating my-1">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(Model.Rating))
                            {
                                <i class="bi bi-star-fill text-warning"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-muted"></i>
                            }
                        }
                    </div>
                    <small class="text-muted">Based on @Model.TotalReviews verified passenger reviews</small>
                </div>

                <!-- Professional Quick Metrics -->
                <div class="row g-2 text-start pt-2 border-top small">
                    <div class="col-6">
                        <span class="text-muted d-block">Trips Completed:</span>
                        <strong class="text-dark fs-6">@Model.CompletedTripsCount</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted d-block">Distance Covered:</span>
                        <strong class="text-dark fs-6">@Model.TotalDistanceTravelled.ToString("N0") km</strong>
                    </div>
                    <div class="col-12 mt-2">
                        <span class="text-muted d-block">Joined Fleet:</span>
                        <strong class="text-dark">@Model.JoiningDate.ToString("MMMM dd, yyyy")</strong>
                    </div>
                    @if (Model.CurrentlyAssignedVehicle != null)
                    {
                        <div class="col-12 mt-2 p-2 bg-light rounded text-center">
                            <small class="text-muted d-block">Assigned Vehicle:</small>
                            <span class="fw-bold text-primary">@Model.CurrentlyAssignedVehicle.VehicleName</span>
                            <span class="badge bg-secondary ms-1">@Model.CurrentlyAssignedVehicle.RegistrationNumber</span>
                        </div>
                    }
                </div>

                <!-- Photo Upload / Removal Controls (Driver or Admin) -->
                @if (User.IsInRole("Driver") || isAdmin)
                {
                    <div class="mt-4 pt-3 border-top">
                        <form asp-controller="Drivers" asp-action="Profile" method="post" enctype="multipart/form-data" id="photoUploadForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="DriverId" />
                            <input type="hidden" asp-for="FullName" />
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="PhoneNumber" />
                            <input type="hidden" asp-for="Address" />
                            <input type="hidden" asp-for="LicenseNumber" />

                            <div class="mb-2">
                                <label class="btn btn-outline-primary btn-sm w-100 rounded-pill mb-1">
                                    <i class="bi bi-camera me-1"></i> Change Photo
                                    <input type="file" asp-for="PhotoUpload" class="d-none" accept=".jpg,.jpeg,.png,.webp" id="avatarFileInput" onchange="previewAndSubmitAvatar(this)" />
                                </label>
                                <small class="text-muted d-block" style="font-size: 0.7rem;">Max 3MB &bull; JPG, PNG, WEBP</small>
                            </div>
                        </form>

                        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                        {
                            <form asp-controller="Drivers" asp-action="RemovePhoto" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="driverId" value="@Model.DriverId" />
                                <button type="submit" class="btn btn-link btn-sm text-danger text-decoration-none p-0" onclick="return confirm('Remove your profile photo?');">
                                    <i class="bi bi-trash3 me-1"></i> Remove Photo
                                </button>
                            </form>
                        }
                    </div>
                }

            </div>
        </div>

        <!-- Right Column: Personal & Professional Edit Form + Rating Distribution & Reviews -->
        <div class="col-12 col-lg-8">
            
            <!-- Personal & Professional Information Card -->
            <div class="card card-modern p-4 shadow-sm border-0 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-lines-fill text-primary me-2"></i> Driver Profile Information</h5>
                    <span class="badge bg-light text-muted border">ID: #@Model.DriverId</span>
                </div>

                <form asp-controller="Drivers" asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="DriverId" />
                    <input type="hidden" asp-for="LicenseNumber" />
                    <input type="hidden" asp-for="LicenseExpiryDate" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold text-dark"></label>
                            <input asp-for="FullName" class="form-control" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-dark"></label>
                            <input asp-for="Email" class="form-control" readonly />
                            <span class="text-muted" style="font-size: 0.7rem;">Email bound to authentication account</span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-semibold text-dark"></label>
                            <input asp-for="PhoneNumber" class="form-control" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">License Number</label>
                            <input type="text" class="form-control bg-light" value="@Model.MaskedLicenseNumber" readonly />
                            <span class="text-muted" style="font-size: 0.7rem;">Sensitive digits masked for security &bull; Expires: @Model.LicenseExpiryDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label small fw-semibold text-dark"></label>
                            <input asp-for="Address" class="form-control" required />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                        <button type="submit" class="btn btn-fleet-primary rounded-pill px-4">
                            <i class="bi bi-check2 me-1"></i> Save Profile Details
                        </button>
                    </div>
                </form>
            </div>

            <!-- Driver Rating Distribution & Reviews Section -->
            <div class="card card-modern p-4 shadow-sm border-0">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-star-fill text-warning me-2"></i> Performance Reviews & Ratings
                    </h5>
                    <span class="badge bg-light text-dark border">@Model.TotalReviews Total Reviews</span>
                </div>

                <!-- Rating Distribution Breakdown -->
                <div class="row g-3 align-items-center mb-4 pb-4 border-bottom">
                    <div class="col-md-4 text-center">
                        <div class="display-5 fw-bold text-dark mb-1">@Model.Rating.ToString("N1")</div>
                        <div class="star-rating mb-1">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(Model.Rating))
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-muted"></i>
                                }
                            }
                        </div>
                        <small class="text-muted d-block">Overall Driver Score</small>
                    </div>

                    <div class="col-md-8">
                        @{
                            int total = Model.TotalReviews > 0 ? Model.TotalReviews : 1;
                        }
                        <!-- 5 Star -->
                        <div class="d-flex align-items-center gap-2 mb-1 small">
                            <span style="width: 50px;">5 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: @(Model.FiveStarCount * 100 / total)%"></div>
                            </div>
                            <span class="text-muted" style="width: 30px; text-align: right;">@Model.FiveStarCount</span>
                        </div>
                        <!-- 4 Star -->
                        <div class="d-flex align-items-center gap-2 mb-1 small">
                            <span style="width: 50px;">4 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: @(Model.FourStarCount * 100 / total)%"></div>
                            </div>
                            <span class="text-muted" style="width: 30px; text-align: right;">@Model.FourStarCount</span>
                        </div>
                        <!-- 3 Star -->
                        <div class="d-flex align-items-center gap-2 mb-1 small">
                            <span style="width: 50px;">3 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: @(Model.ThreeStarCount * 100 / total)%"></div>
                            </div>
                            <span class="text-muted" style="width: 30px; text-align: right;">@Model.ThreeStarCount</span>
                        </div>
                        <!-- 2 Star -->
                        <div class="d-flex align-items-center gap-2 mb-1 small">
                            <span style="width: 50px;">2 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: @(Model.TwoStarCount * 100 / total)%"></div>
                            </div>
                            <span class="text-muted" style="width: 30px; text-align: right;">@Model.TwoStarCount</span>
                        </div>
                        <!-- 1 Star -->
                        <div class="d-flex align-items-center gap-2 small">
                            <span style="width: 50px;">1 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-danger" style="width: @(Model.OneStarCount * 100 / total)%"></div>
                            </div>
                            <span class="text-muted" style="width: 30px; text-align: right;">@Model.OneStarCount</span>
                        </div>
                    </div>
                </div>

                <!-- Recent Reviews List -->
                <div class="reviews-list">
                    @if (Model.Reviews.Any())
                    {
                        foreach (var review in Model.Reviews)
                        {
                            <div class="p-3 mb-3 rounded-3 bg-light border position-relative">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-placeholder" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            @((review.ReviewerUser?.FullName?.Length > 0 ? review.ReviewerUser.FullName[0].ToString().ToUpper() : "R"))
                                        </div>
                                        <div>
                                            <span class="fw-bold small text-dark d-block">@(review.ReviewerUser?.FullName ?? "Passenger / Staff")</span>
                                            <small class="text-muted" style="font-size: 0.7rem;">Trip #@review.TripId &bull; @review.ReviewDate.ToString("MMM dd, yyyy")</small>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <div class="star-rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="bi bi-star-fill text-warning" style="font-size: 0.85rem;"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-muted" style="font-size: 0.85rem;"></i>
                                                }
                                            }
                                        </div>

                                        @if (isAdmin)
                                        {
                                            <form asp-controller="Drivers" asp-action="ModerateReview" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reviewId" value="@review.ReviewId" />
                                                <input type="hidden" name="driverId" value="@Model.DriverId" />
                                                <input type="hidden" name="hideReview" value="@(!review.IsModerated ? "true" : "false")" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2 rounded" title="Admin Moderate">
                                                    <i class="bi bi-shield-x"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                                <p class="mb-0 text-secondary small">"@review.Comment"</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-chat-square-heart display-6 d-block mb-2 text-muted"></i>
                            <h6 class="fw-semibold text-dark">No reviews yet</h6>
                            <p class="small text-muted mb-0">Reviews from passengers will appear here once trips are completed.</p>
                        </div>
                    }
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewAndSubmitAvatar(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                if (file.size > 3 * 1024 * 1024) {
                    alert('Image file size must not exceed 3MB.');
                    input.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('profileImagePreview');
                    const placeholder = document.getElementById('profilePlaceholder');
                    if (preview) {
                        preview.src = e.target.result;
                        preview.classList.remove('d-none');
                    }
                    if (placeholder) {
                        placeholder.classList.add('d-none');
                    }
                };
                reader.readAsDataURL(file);
                // Auto submit form to upload
                document.getElementById('photoUploadForm').submit();
            }
        }
    </script>
}
