@model VehicleFleetManagement.Models.Driver
@{
    ViewData["Title"] = $"Remove / Deactivate {Model.FullName}";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-custom p-4 shadow-sm border-danger border-top border-4">
            <div class="text-center mb-4">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 d-inline-flex mb-2">
                    <i class="bi bi-person-x-fill fs-1"></i>
                </div>
                <h3 class="fw-bold text-dark">Remove or Deactivate Driver</h3>
                <p class="text-muted small">Are you sure you want to remove or deactivate this driver?</p>
            </div>

            <div class="alert alert-info small mb-4">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Relational Integrity Guard:</strong> If this driver is attached to any active or completed trip records, the system will automatically preserve audit history by setting the status to <strong>Inactive</strong> rather than purging the record.
            </div>

            <div class="bg-light p-3 rounded mb-4">
                <div class="row g-2 small">
                    <div class="col-sm-5 text-muted fw-semibold">Driver Full Name:</div>
                    <div class="col-sm-7 fw-bold text-dark">@Model.FullName</div>

                    <div class="col-sm-5 text-muted fw-semibold">License Number:</div>
                    <div class="col-sm-7 fw-bold font-monospace text-primary">@Model.LicenseNumber</div>

                    <div class="col-sm-5 text-muted fw-semibold">Email Address:</div>
                    <div class="col-sm-7">@Model.Email</div>

                    <div class="col-sm-5 text-muted fw-semibold">Phone:</div>
                    <div class="col-sm-7">@Model.PhoneNumber</div>

                    <div class="col-sm-5 text-muted fw-semibold">Availability Status:</div>
                    <div class="col-sm-7"><span class="badge bg-secondary">@Model.AvailabilityStatus</span></div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DriverId" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i> Confirm Removal / Deactivation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
