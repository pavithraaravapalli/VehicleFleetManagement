@model VehicleFleetManagement.Models.Driver
@{
    ViewData["Title"] = $"{Model.FullName} Profile";
    bool isLicenseExpiring = Model.LicenseExpiryDate < DateTime.UtcNow.AddDays(30);
    bool isLicenseExpired = Model.LicenseExpiryDate < DateTime.UtcNow;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0" style="color: #172554;">@Model.FullName</h2>
            <span class="badge bg-secondary font-monospace">@Model.LicenseNumber</span>
            @if (Model.AvailabilityStatus == "Available")
            {
                <span class="badge bg-success">Available</span>
            }
            else if (Model.AvailabilityStatus == "OnTrip")
            {
                <span class="badge bg-primary">On Trip</span>
            }
            else
            {
                <span class="badge bg-danger">@Model.AvailabilityStatus</span>
            }
        </div>
        <p class="text-muted small mb-0 mt-1">Driver Profile, Credential Verification, and Operating Trip History</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.DriverId" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i> Edit Driver
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Drivers
        </a>
    </div>
</div>

<!-- License Expiry Alert if applicable -->
@if (isLicenseExpired)
{
    <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill fs-4 me-2"></i>
        <div>
            <strong>Compliance Warning:</strong> This driver's license expired on <strong>@Model.LicenseExpiryDate.ToString("D")</strong>. Do not dispatch until license renewal is confirmed.
        </div>
    </div>
}
else if (isLicenseExpiring)
{
    <div class="alert alert-warning shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-2"></i>
        <div>
            <strong>License Renewal Due:</strong> This driver's license expires soon on <strong>@Model.LicenseExpiryDate.ToString("D")</strong>.
        </div>
    </div>
}

<!-- Driver Profile Overview -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3">
            <div class="text-muted small fw-semibold text-uppercase">Email Address</div>
            <div class="fs-6 fw-bold text-dark mt-1 text-truncate">@Model.Email</div>
            <div class="small text-muted">Official correspondence</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3">
            <div class="text-muted small fw-semibold text-uppercase">Phone Number</div>
            <div class="fs-6 fw-bold text-dark mt-1">@Model.PhoneNumber</div>
            <div class="small text-muted">Primary mobile contact</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3">
            <div class="text-muted small fw-semibold text-uppercase">License Expiry</div>
            <div class="fs-6 fw-bold mt-1 @(isLicenseExpiring ? "text-danger" : "text-dark")">
                @Model.LicenseExpiryDate.ToString("d")
            </div>
            <div class="small text-muted">Issued valid driver credential</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3">
            <div class="text-muted small fw-semibold text-uppercase">Joining Date</div>
            <div class="fs-6 fw-bold text-dark mt-1">@Model.JoiningDate.ToString("d")</div>
            <div class="small text-muted">Tenure with organization</div>
        </div>
    </div>
</div>

<div class="card card-custom p-3 mb-4">
    <div class="text-muted small fw-semibold text-uppercase mb-1">Residential Address</div>
    <div class="text-dark">@Model.Address</div>
</div>

<!-- Driver Trip History -->
<div class="card card-custom shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold" style="color: #172554;">
            <i class="bi bi-signpost-2-fill me-1 text-primary"></i> Assigned Trip History (@(Model.Trips?.Count ?? 0))
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Trip #</th>
                        <th>Vehicle Assigned</th>
                        <th>Route</th>
                        <th>Start Date</th>
                        <th>Distance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Trips != null && Model.Trips.Any())
                    {
                        foreach (var t in Model.Trips)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@t.TripId</td>
                                <td>
                                    <strong>@(t.Vehicle?.VehicleName ?? "N/A")</strong>
                                    <div class="small text-muted">@t.Vehicle?.RegistrationNumber</div>
                                </td>
                                <td>
                                    @t.Source <i class="bi bi-arrow-right mx-1 text-muted"></i> @t.Destination
                                </td>
                                <td>@t.StartDate.ToString("g")</td>
                                <td>@t.Distance.ToString("N0") km</td>
                                <td>
                                    @if (t.TripStatus == "Completed")
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (t.TripStatus == "InProgress")
                                    {
                                        <span class="badge bg-primary">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@t.TripStatus</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-2 d-block mb-2 text-secondary"></i>
                                No trips have been assigned to this driver yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
