@model IEnumerable<VehicleFleetManagement.Models.Notification>
@{
    ViewData["Title"] = "Notification Center - FleetFlow Pro";
    var unreadCount = ViewBag.UnreadCount as int? ?? 0;
}

<div class="container py-4">
    <!-- Header with Mark All as Read Action -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-bell-fill text-warning me-2"></i> Notification Center
            </h3>
            <p class="text-muted small mb-0">Operational dispatch alerts, maintenance schedules, license renewals, and fleet updates</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (unreadCount > 0)
            {
                <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="bi bi-check2-all me-1"></i> Mark All as Read
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Notifications List Card -->
    <div class="card card-modern shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark small">All Activity & Alerts</span>
            @if (unreadCount > 0)
            {
                <span class="badge bg-danger rounded-pill">@unreadCount Unread</span>
            }
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var n in Model)
                    {
                        <div class="list-group-item p-3 p-md-4 d-flex justify-content-between align-items-start gap-3 @(!n.IsRead ? "bg-light bg-opacity-75" : "")">
                            <div class="d-flex align-items-start gap-3 flex-grow-1">
                                <!-- Type Icon -->
                                <div class="stat-icon-wrapper rounded-circle flex-shrink-0 @(n.Type == "MaintenanceDue" ? "bg-warning bg-opacity-10 text-warning" : n.Type == "LicenseExpiry" ? "bg-danger bg-opacity-10 text-danger" : n.Type == "VehicleIssueReported" ? "bg-danger bg-opacity-10 text-danger" : "bg-primary bg-opacity-10 text-primary")" style="width: 42px; height: 42px;">
                                    @if (n.Type == "MaintenanceDue" || n.Type == "OverdueService")
                                    {
                                        <i class="bi bi-tools fs-5"></i>
                                    }
                                    else if (n.Type == "LicenseExpiry")
                                    {
                                        <i class="bi bi-person-exclamation fs-5"></i>
                                    }
                                    else if (n.Type == "VehicleIssueReported" || n.Type == "VehicleIssueUpdate")
                                    {
                                        <i class="bi bi-wrench fs-5"></i>
                                    }
                                    else if (n.Type == "TripAssigned")
                                    {
                                        <i class="bi bi-signpost-2 fs-5"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-info-circle fs-5"></i>
                                    }
                                </div>

                                <!-- Text Content -->
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                        <h6 class="fw-bold text-dark mb-0">@n.Title</h6>
                                        @if (!n.IsRead)
                                        {
                                            <span class="badge bg-primary" style="font-size: 0.65rem;">NEW</span>
                                        }
                                        <small class="text-muted" style="font-size: 0.75rem;">&bull; @n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                    </div>
                                    <p class="mb-2 text-secondary small">@n.Message</p>

                                    @if (!string.IsNullOrEmpty(n.ActionUrl))
                                    {
                                        <a href="@n.ActionUrl" class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold small text-primary">
                                            View Related Record <i class="bi bi-arrow-right"></i>
                                        </a>
                                    }
                                </div>
                            </div>

                            <!-- Mark as Read Button -->
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkAsRead" asp-route-id="@n.NotificationId" method="post" class="flex-shrink-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm py-1 px-3 rounded-pill" title="Mark as Read">
                                        <i class="bi bi-check2"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-bell-slash display-5 d-block mb-2 text-muted"></i>
                    <h6 class="fw-semibold text-dark">No notifications to display</h6>
                    <p class="small text-muted mb-0">You will be alerted here whenever new trips, maintenance milestones, or faults are registered.</p>
                </div>
            }
        </div>
    </div>
</div>
