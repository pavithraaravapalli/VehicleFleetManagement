@model VehicleFleetManagement.Models.Vehicle
@{
    ViewData["Title"] = $"Delete Vehicle {Model.RegistrationNumber}";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-custom p-4 shadow-sm border-danger border-top border-4">
            <div class="text-center mb-4">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 d-inline-flex mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                </div>
                <h3 class="fw-bold text-dark">Confirm Vehicle Deletion</h3>
                <p class="text-muted small">Are you sure you want to permanently delete this vehicle from the database?</p>
            </div>

            <div class="alert alert-warning small mb-4">
                <i class="bi bi-shield-exclamation me-1"></i>
                <strong>Audit Rule:</strong> If this vehicle has historical or active trip records, the system will prevent hard deletion to maintain audit integrity. In such cases, mark the status as <strong>Inactive</strong>.
            </div>

            <div class="bg-light p-3 rounded mb-4">
                <div class="row g-2 small">
                    <div class="col-sm-5 text-muted fw-semibold">Registration Number:</div>
                    <div class="col-sm-7 fw-bold text-primary">@Model.RegistrationNumber</div>

                    <div class="col-sm-5 text-muted fw-semibold">Vehicle Name / Make:</div>
                    <div class="col-sm-7 fw-bold text-dark">@Model.VehicleName</div>

                    <div class="col-sm-5 text-muted fw-semibold">Model:</div>
                    <div class="col-sm-7">@Model.Model</div>

                    <div class="col-sm-5 text-muted fw-semibold">Current Odometer:</div>
                    <div class="col-sm-7">@Model.CurrentOdometer.ToString("N0") km</div>

                    <div class="col-sm-5 text-muted fw-semibold">Status:</div>
                    <div class="col-sm-7"><span class="badge bg-secondary">@Model.Status</span></div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="VehicleId" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i> Permanently Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
