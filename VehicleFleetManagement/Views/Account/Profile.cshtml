@model VehicleFleetManagement.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "My Profile - FleetFlow Pro";
}

<div class="container py-4">
    <!-- Breadcrumb & Top Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">My Profile</li>
            </ol>
        </nav>
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Back to Workspace
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2 flex-shrink-0 text-success"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-5 me-2 flex-shrink-0 text-danger"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left Profile Identity Card -->
        <div class="col-12 col-lg-4">
            <div class="card card-modern p-4 text-center shadow-sm border-0 mb-4">
                
                <!-- Avatar with Client-side Upload Preview -->
                <div class="position-relative d-inline-block mx-auto mb-3">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="@Model.FullName" class="avatar-circle-lg mx-auto" id="profileImagePreview" />
                    }
                    else
                    {
                        <div class="avatar-placeholder-lg mx-auto" id="profilePlaceholder">
                            @((Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "U"))
                        </div>
                        <img src="" alt="Preview" class="avatar-circle-lg mx-auto d-none" id="profileImagePreview" />
                    }
                </div>

                <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-2"><i class="bi bi-envelope text-primary me-1"></i> @Model.Email</p>

                <!-- Status & Role Badges -->
                <div class="mb-3 d-flex justify-content-center gap-2 flex-wrap">
                    <span class="badge bg-primary rounded-pill px-3 py-1">
                        <i class="bi bi-person-badge me-1"></i> Staff Member
                    </span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                        <i class="bi bi-check-circle-fill me-1"></i> Account Active
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <form asp-controller="Account" asp-action="RemoveProfilePicture" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="return confirm('Remove your current profile photo?');">
                            <i class="bi bi-trash3 me-1"></i> Remove Photo
                        </button>
                    </form>
                }

                <hr class="my-3 text-muted" />

                <!-- Account Metrics -->
                <div class="row g-2 text-center small">
                    <div class="col-6">
                        <div class="p-2 rounded bg-light">
                            <div class="text-muted" style="font-size: 0.75rem;">Member Since</div>
                            <strong class="text-dark">@Model.CreatedAt.ToString("MMM yyyy")</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded bg-light">
                            <div class="text-muted" style="font-size: 0.75rem;">Reviews Given</div>
                            <strong class="text-primary">@Model.ReviewsCount Reviews</strong>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Right Profile Management Tabs -->
        <div class="col-12 col-lg-8">
            <div class="card card-modern shadow-sm border-0 p-4">
                
                <!-- Tab Navigation Headers -->
                <ul class="nav nav-tabs border-bottom mb-4" id="profileTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold text-dark" id="info-tab" data-bs-toggle="tab" data-bs-target="#info-pane" type="button" role="tab" aria-controls="info-pane" aria-selected="true">
                            <i class="bi bi-person me-1 text-primary"></i> Personal Information
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold text-dark" id="security-tab" data-bs-toggle="tab" data-bs-target="#security-pane" type="button" role="tab" aria-controls="security-pane" aria-selected="false">
                            <i class="bi bi-shield-lock me-1 text-warning"></i> Password & Security
                        </button>
                    </li>
                </ul>

                <!-- Tab Contents -->
                <div class="tab-content" id="profileTabContent">
                    
                    <!-- Tab 1: Personal Details Form -->
                    <div class="tab-pane fade show active" id="info-pane" role="tabpanel" aria-labelledby="info-tab" tabindex="0">
                        <form asp-controller="Account" asp-action="Profile" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="UserId" />
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="ProfilePictureUrl" />
                            <input type="hidden" asp-for="RoleName" />
                            <input type="hidden" asp-for="CreatedAt" />
                            <input type="hidden" asp-for="ReviewsCount" />

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-6">
                                    <label asp-for="FullName" class="form-label small fw-semibold text-dark"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person"></i></span>
                                        <input asp-for="FullName" class="form-control border-start-0" placeholder="Your full legal name" required />
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="Email" class="form-label small fw-semibold text-dark"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                                        <input asp-for="Email" class="form-control border-start-0 bg-light" disabled readonly />
                                    </div>
                                    <div class="form-text small text-muted">Email is managed by organizational identity.</div>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label small fw-semibold text-dark"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-telephone"></i></span>
                                        <input asp-for="PhoneNumber" class="form-control border-start-0" placeholder="+1-555-0199" />
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="ProfilePicture" class="form-label small fw-semibold text-dark"></label>
                                    <input asp-for="ProfilePicture" type="file" class="form-control" id="profileImageInput" accept=".jpg,.jpeg,.png,.webp" />
                                    <span asp-validation-for="ProfilePicture" class="text-danger small"></span>
                                    <div class="form-text small text-muted">Supports JPG, PNG, WEBP (Max 2MB).</div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end pt-3 border-top mt-4">
                                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                    <i class="bi bi-check2-circle me-1"></i> Save Profile Changes
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Tab 2: Change Password Form -->
                    <div class="tab-pane fade" id="security-pane" role="tabpanel" aria-labelledby="security-tab" tabindex="0">
                        <form asp-controller="Account" asp-action="ChangePassword" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="ChangePassword.CurrentPassword" class="form-label small fw-semibold text-dark"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-lock"></i></span>
                                    <input asp-for="ChangePassword.CurrentPassword" type="password" class="form-control border-start-0" id="currentPassInput" required />
                                    <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePassVisibility('currentPassInput', 'currentPassIcon')">
                                        <i class="bi bi-eye" id="currentPassIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ChangePassword.NewPassword" class="form-label small fw-semibold text-dark"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-key"></i></span>
                                    <input asp-for="ChangePassword.NewPassword" type="password" class="form-control border-start-0" id="newPassInput" required />
                                    <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePassVisibility('newPassInput', 'newPassIcon')">
                                        <i class="bi bi-eye" id="newPassIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ChangePassword.NewPassword" class="text-danger small"></span>
                                <div class="form-text small text-muted">Must be at least 6 characters with letters and numbers.</div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ChangePassword.ConfirmPassword" class="form-label small fw-semibold text-dark"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-check2-all"></i></span>
                                    <input asp-for="ChangePassword.ConfirmPassword" type="password" class="form-control border-start-0" id="confirmPassInput" required />
                                    <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePassVisibility('confirmPassInput', 'confirmPassIcon')">
                                        <i class="bi bi-eye" id="confirmPassIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ChangePassword.ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <div class="d-flex justify-content-end pt-3 border-top mt-4">
                                <button type="submit" class="btn btn-warning rounded-pill px-4 text-dark shadow-sm fw-semibold">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Update Password
                                </button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live client-side preview for profile image upload
        const imageInput = document.getElementById('profileImageInput');
        const imagePreview = document.getElementById('profileImagePreview');
        const placeholder = document.getElementById('profilePlaceholder');

        if (imageInput) {
            imageInput.addEventListener('change', function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        imagePreview.src = e.target.result;
                        imagePreview.classList.remove('d-none');
                        if (placeholder) {
                            placeholder.classList.add('d-none');
                        }
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        // Toggle password show/hide helper
        function togglePassVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input && icon) {
                const isPassword = input.getAttribute('type') === 'password';
                input.setAttribute('type', isPassword ? 'text' : 'password');
                icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
            }
        }
    </script>
}
