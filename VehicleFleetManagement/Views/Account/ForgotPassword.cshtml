@model VehicleFleetManagement.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password - FleetFlow Pro";
    bool resetSent = ViewBag.ResetSent ?? false;
    string? resetLink = ViewBag.ResetLink as string;
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card card-modern p-4 p-sm-5 shadow-lg border-0 rounded-4">
                
                <!-- Brand Header -->
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle mb-3" style="background-color: var(--fleet-primary-light); color: var(--fleet-primary);">
                        <i class="bi bi-shield-lock-fill display-6"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Reset Password</h3>
                    <p class="text-muted small">Enter your email to receive recovery instructions</p>
                </div>

                @if (resetSent)
                {
                    <div class="alert alert-success border-0 shadow-sm p-3 mb-4 rounded-3 text-center">
                        <i class="bi bi-check-circle-fill fs-3 text-success d-block mb-2"></i>
                        <h6 class="fw-bold mb-1">Password Reset Token Generated</h6>
                        <p class="small text-muted mb-0">If an account exists with that email, password recovery instructions have been initiated.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(resetLink))
                    {
                        <div class="p-3 mb-4 rounded-3 bg-light border text-center">
                            <span class="small fw-semibold text-dark d-block mb-2"><i class="bi bi-key-fill text-primary me-1"></i> Development / Direct Reset Link</span>
                            <a href="@resetLink" class="btn btn-primary btn-sm rounded-pill px-3">
                                <i class="bi bi-arrow-right-circle me-1"></i> Proceed to Set New Password
                            </a>
                        </div>
                    }

                    <div class="text-center pt-2">
                        <a asp-action="Login" class="btn btn-outline-secondary btn-sm rounded-pill px-4">
                            <i class="bi bi-arrow-left me-1"></i> Return to Sign In
                        </a>
                    </div>
                }
                else
                {
                    <form asp-action="ForgotPassword" method="post" id="forgotForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label small fw-semibold text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control border-start-0" placeholder="user@fleet.com" autocomplete="email" required autofocus />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill shadow-sm fw-semibold mb-3">
                            <i class="bi bi-send-check me-1"></i> Generate Password Reset Link
                        </button>

                        <div class="text-center">
                            <a asp-action="Login" class="text-decoration-none small text-muted">
                                <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                            </a>
                        </div>
                    </form>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
