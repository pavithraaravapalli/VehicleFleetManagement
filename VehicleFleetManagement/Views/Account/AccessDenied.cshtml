@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card card-custom p-5 shadow-sm">
            <div class="mb-3">
                <i class="bi bi-shield-x text-danger display-1"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Access Denied (HTTP 403)</h2>
            <p class="text-muted mb-4">
                You do not possess the required role permissions to access this administrative resource or data record.
                If you believe this is in error, please contact your Fleet Management System Administrator.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-house-door me-1"></i> Return to Dashboard
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
