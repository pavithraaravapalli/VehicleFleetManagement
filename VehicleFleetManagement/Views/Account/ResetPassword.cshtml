@model VehicleFleetManagement.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password - FleetFlow Pro";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card card-modern p-4 p-sm-5 shadow-lg border-0 rounded-4">
                
                <!-- Brand Header -->
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle mb-3" style="background-color: var(--fleet-primary-light); color: var(--fleet-primary);">
                        <i class="bi bi-key-fill display-6"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Set New Password</h3>
                    <p class="text-muted small">Choose a secure password for @Model.Email</p>
                </div>

                <form asp-action="ResetPassword" method="post" id="resetForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-dark"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" id="newPassInput" class="form-control border-start-0 border-end-0" placeholder="••••••••" required autofocus />
                            <button class="btn btn-outline-secondary border-start-0 bg-light text-muted" type="button" onclick="togglePass('newPassInput', 'newPassIcon')">
                                <i class="bi bi-eye" id="newPassIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="form-text small text-muted">Must be at least 6 characters with letters and numbers.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-dark"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-check2-all"></i></span>
                            <input asp-for="ConfirmPassword" type="password" id="confirmPassInput" class="form-control border-start-0 border-end-0" placeholder="••••••••" required />
                            <button class="btn btn-outline-secondary border-start-0 bg-light text-muted" type="button" onclick="togglePass('confirmPassInput', 'confirmPassIcon')">
                                <i class="bi bi-eye" id="confirmPassIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill shadow-sm fw-semibold mb-3">
                        <i class="bi bi-check-circle me-1"></i> Update Password & Sign In
                    </button>

                    <div class="text-center">
                        <a asp-action="Login" class="text-decoration-none small text-muted">
                            <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePass(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input && icon) {
                const isPassword = input.getAttribute('type') === 'password';
                input.setAttribute('type', isPassword ? 'text' : 'password');
                icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
            }
        }
    </script>
}
