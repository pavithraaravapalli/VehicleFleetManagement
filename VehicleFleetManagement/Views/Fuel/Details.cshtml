@model VehicleFleetManagement.Models.FuelLog
@{
    ViewData["Title"] = $"Fuel Receipt #{Model.FuelLogId}";
    decimal? mileage = ViewBag.CalculatedMileage as decimal?;
    bool isAdmin = User.IsInRole("Admin");
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <!-- Breadcrumb / Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <a asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Fuel Logs
                </a>
                <h2 class="fw-bold mb-0 mt-1" style="color: #172554;">
                    <i class="bi bi-receipt text-primary me-2"></i>Fuel Purchase Receipt #@Model.FuelLogId
                </h2>
            </div>
            <div class="d-flex gap-2">
                @if (isAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@Model.FuelLogId" class="btn btn-outline-primary">
                        <i class="bi bi-pencil-square me-1"></i> Edit Record
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.FuelLogId" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Delete
                    </a>
                }
                <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print Receipt
                </button>
            </div>
        </div>

        <!-- Summary Highlight Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-6">
                <div class="card card-custom p-3 text-center border-start border-success border-4 h-100">
                    <div class="text-muted small fw-semibold text-uppercase">Total Cost</div>
                    <div class="fs-4 fw-bold text-success mt-1">$@Model.TotalCost.ToString("N2")</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card card-custom p-3 text-center border-start border-primary border-4 h-100">
                    <div class="text-muted small fw-semibold text-uppercase">Quantity Pumped</div>
                    <div class="fs-4 fw-bold text-primary mt-1">@Model.FuelQuantity.ToString("N2") L</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card card-custom p-3 text-center border-start border-info border-4 h-100">
                    <div class="text-muted small fw-semibold text-uppercase">Unit Price</div>
                    <div class="fs-4 fw-bold text-dark mt-1">$@Model.PricePerLitre.ToString("N2") / L</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card card-custom p-3 text-center border-start border-warning border-4 h-100">
                    <div class="text-muted small fw-semibold text-uppercase">Calculated Mileage</div>
                    @if (mileage.HasValue && mileage.Value > 0)
                    {
                        <div class="fs-4 fw-bold text-warning mt-1">@mileage.Value.ToString("N1") km/L</div>
                    }
                    else
                    {
                        <div class="fs-6 fw-bold text-muted mt-2">N/A (First Log)</div>
                    }
                </div>
            </div>
        </div>

        <!-- Transaction Details Card -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-fuel-pump me-2 text-primary"></i>Purchase & Refill Specifications
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold d-block">Fuel Station / Vendor</label>
                        <span class="fs-5 fw-bold text-dark">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.FuelStation
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold d-block">Transaction Date</label>
                        <span class="fs-5 text-dark">
                            <i class="bi bi-calendar3 text-primary me-1"></i>@Model.FuelDate.ToString("dddd, MMMM dd, yyyy")
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold d-block">Odometer at Refill</label>
                        <span class="fs-5 text-dark fw-bold">
                            <i class="bi bi-speedometer2 text-info me-1"></i>@Model.OdometerReading.ToString("N0") km
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold d-block">Fuel Consumption Formula</label>
                        <span class="small text-muted">
                            Cost = @Model.FuelQuantity.ToString("N2") L &times; $@Model.PricePerLitre.ToString("N2") = <strong>$@Model.TotalCost.ToString("N2")</strong>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assigned Vehicle Card -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-truck me-2 text-primary"></i>Vehicle Information
                </h5>
                <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@Model.VehicleId" class="btn btn-sm btn-outline-secondary">
                    View Vehicle Dossier
                </a>
            </div>
            <div class="card-body p-4">
                @if (Model.Vehicle != null)
                {
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="text-muted small fw-semibold">Vehicle Name / Make</div>
                            <div class="fw-bold fs-5 text-dark">@Model.Vehicle.VehicleName</div>
                            <div class="small text-muted">@Model.Vehicle.Model (@Model.Vehicle.ManufacturingYear)</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small fw-semibold">Registration Number</div>
                            <div>
                                <span class="badge bg-dark px-3 py-2 fs-6">@Model.Vehicle.RegistrationNumber</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small fw-semibold">Fuel Type & Current Odometer</div>
                            <div class="fw-semibold text-dark">
                                <span class="badge bg-info text-dark">@Model.Vehicle.FuelType</span>
                            </div>
                            <div class="small text-muted mt-1">Current Fleet Odometer: <strong>@Model.Vehicle.CurrentOdometer.ToString("N0") km</strong></div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">Vehicle metadata unavailable.</p>
                }
            </div>
        </div>

        <!-- Optional Associated Trip Card -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-map me-2 text-primary"></i>Associated Trip Assignment
                </h5>
            </div>
            <div class="card-body p-4">
                @if (Model.Trip != null)
                {
                    <div class="row g-3 align-items-center">
                        <div class="col-md-6">
                            <div class="text-muted small fw-semibold">Trip Route</div>
                            <div class="fw-bold fs-5 text-dark">
                                @Model.Trip.Source <i class="bi bi-arrow-right text-primary mx-1"></i> @Model.Trip.Destination
                            </div>
                            <div class="small text-muted">Trip #@Model.Trip.TripId &bull; Status: <span class="badge bg-secondary">@Model.Trip.TripStatus</span></div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small fw-semibold">Trip Schedule</div>
                            <div class="small text-dark">Dep: @Model.Trip.StartDate.ToString("MMM dd, yyyy")</div>
                            <div class="small text-muted">Exp. Arr: @Model.Trip.ExpectedEndDate.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="col-md-2 text-end">
                            <a asp-controller="Trips" asp-action="Details" asp-route-id="@Model.Trip.TripId" class="btn btn-outline-primary btn-sm">
                                View Trip
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted py-2">
                        <i class="bi bi-info-circle me-1"></i> This fuel refill was recorded directly for the fleet vehicle and not linked to an active scheduled trip.
                    </div>
                }
            </div>
        </div>

        <!-- Mileage Assessment Note -->
        <div class="alert alert-light border p-3 rounded-3 d-flex align-items-center">
            <i class="bi bi-info-circle-fill text-primary fs-3 me-3"></i>
            <div>
                <strong class="d-block text-dark">Mileage Calculation Logic (INT 402 Viva Insight):</strong>
                <span class="small text-muted">
                    Mileage is calculated dynamically by querying the immediate preceding fuel log for this specific vehicle ordered by odometer reading:
                    <code>Mileage (km/L) = (Current Odometer - Previous Odometer) / Fuel Litres Consumed</code>.
                </span>
            </div>
        </div>
    </div>
</div>
