@model VehicleFleetManagement.ViewModels.CreateFuelLogViewModel
@{
    ViewData["Title"] = $"Edit Fuel Log #{Model.FuelLogId}";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Fuel Logs
                </a>
                <h2 class="fw-bold mb-0 mt-1" style="color: #172554;">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Fuel Record #@Model.FuelLogId
                </h2>
                <p class="text-muted small mb-0">Update fuel receipt details, quantity, cost, and odometer reading</p>
            </div>
        </div>

        <div class="card card-custom shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.FuelLogId" method="post" id="fuelEditForm">
                    <input type="hidden" asp-for="FuelLogId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Vehicle Selection -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="VehicleId" class="form-label fw-semibold">
                                Target Vehicle <span class="text-danger">*</span>
                            </label>
                            <select asp-for="VehicleId" asp-items="Model.AvailableVehicles" class="form-select" id="vehicleSelect" required>
                                <option value="">-- Choose Target Vehicle --</option>
                            </select>
                            <span asp-validation-for="VehicleId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="TripId" class="form-label fw-semibold">
                                Associated Trip (Optional)
                            </label>
                            <select asp-for="TripId" asp-items="Model.AvailableTrips" class="form-select">
                                <option value="">-- Standalone Refill (No Trip) --</option>
                            </select>
                            <span asp-validation-for="TripId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Fuel Station & Date -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="FuelStation" class="form-label fw-semibold">
                                Fuel Station / Vendor <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="FuelStation" class="form-control" placeholder="e.g. Shell Express, TotalEnergies Hwy 4" required />
                            </div>
                            <span asp-validation-for="FuelStation" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="FuelDate" class="form-label fw-semibold">
                                Purchase Date <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FuelDate" type="date" class="form-control" required />
                            <span asp-validation-for="FuelDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Quantity, Price & Live Total Cost Calculation -->
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-4">
                                <label asp-for="FuelQuantity" class="form-label fw-semibold">
                                    Quantity (Litres) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="FuelQuantity" class="form-control" type="number" step="0.01" min="0.01" max="2000" id="fuelQuantity" placeholder="0.00" required />
                                    <span class="input-group-text">L</span>
                                </div>
                                <span asp-validation-for="FuelQuantity" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="PricePerLitre" class="form-label fw-semibold">
                                    Price / Litre ($) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="PricePerLitre" class="form-control" type="number" step="0.01" min="0.01" max="1000" id="pricePerLitre" placeholder="0.00" required />
                                </div>
                                <span asp-validation-for="PricePerLitre" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 text-center border-start">
                                <label class="form-label fw-semibold text-muted small text-uppercase mb-1">Calculated Total Cost</label>
                                <div class="fs-4 fw-bold text-success" id="totalCostDisplay">$@Model.TotalCost.ToString("N2")</div>
                                <small class="text-muted">Auto-computed (Qty &times; Price)</small>
                            </div>
                        </div>
                    </div>

                    <!-- Odometer Reading -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="OdometerReading" class="form-label fw-semibold">
                                Odometer at Refill (km) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-speedometer2"></i></span>
                                <input asp-for="OdometerReading" class="form-control" type="number" step="0.01" min="0" id="odometerReading" placeholder="Odometer reading" required />
                                <span class="input-group-text">km</span>
                            </div>
                            <span asp-validation-for="OdometerReading" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4 text-muted" />

                    <!-- Form Buttons -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Update Fuel Log
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function updateTotalCost() {
                var qty = parseFloat($('#fuelQuantity').val()) || 0;
                var price = parseFloat($('#pricePerLitre').val()) || 0;
                var total = qty * price;
                $('#totalCostDisplay').text('$' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            }

            $('#fuelQuantity, #pricePerLitre').on('input change', updateTotalCost);
            updateTotalCost();
        });
    </script>
}
