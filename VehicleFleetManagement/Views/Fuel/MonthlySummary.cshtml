@model IEnumerable<VehicleFleetManagement.ViewModels.MonthlyFuelExpenseSummary>
@{
    int selectedYear = ViewBag.SelectedYear ?? DateTime.UtcNow.Year;
    ViewData["Title"] = $"Monthly Fuel Expenditure Summary - {selectedYear}";

    decimal annualCost = Model.Sum(m => m.TotalCost);
    decimal annualQuantity = Model.Sum(m => m.TotalQuantity);
    int annualRefills = Model.Sum(m => m.RefillCount);
    decimal annualAvgPrice = annualQuantity > 0 ? annualCost / annualQuantity : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Fuel Logs
        </a>
        <h2 class="fw-bold mb-1 mt-1" style="color: #172554;">
            <i class="bi bi-calendar-month text-primary me-2"></i>Monthly Fuel Expense Summary (@selectedYear)
        </h2>
        <p class="text-muted small mb-0">Aggregated breakdown of fleet fuel procurement and volume metrics</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <form method="get" asp-action="MonthlySummary" class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 fw-semibold text-muted small">Year:</label>
            <select name="year" class="form-select form-select-sm" onchange="this.form.submit()" style="width: 110px;">
                @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 4; y--)
                {
                    if (y == selectedYear)
                    {
                        <option value="@y" selected>@y</option>
                    }
                    else
                    {
                        <option value="@y">@y</option>
                    }
                }
            </select>
        </form>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Summary
        </button>
    </div>
</div>

<!-- Annual Totals Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Annual Expenditure</div>
                    <div class="fs-4 fw-bold text-success mt-1">$@annualCost.ToString("N2")</div>
                </div>
                <div class="bg-success bg-opacity-10 text-success rounded-circle p-3">
                    <i class="bi bi-cash-coin fs-4"></i>
                </div>
            </div>
            <div class="small text-muted mt-2">Total annual fuel invoice sum</div>
        </div>
    </div>

    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Annual Volume</div>
                    <div class="fs-4 fw-bold text-primary mt-1">@annualQuantity.ToString("N1") L</div>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                    <i class="bi bi-droplet-half fs-4"></i>
                </div>
            </div>
            <div class="small text-muted mt-2">Cumulative litres pumped</div>
        </div>
    </div>

    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-info border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Refill Visits</div>
                    <div class="fs-4 fw-bold text-dark mt-1">@annualRefills</div>
                </div>
                <div class="bg-info bg-opacity-10 text-info rounded-circle p-3">
                    <i class="bi bi-fuel-pump fs-4"></i>
                </div>
            </div>
            <div class="small text-muted mt-2">Transactions across fuel stations</div>
        </div>
    </div>

    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Weighted Average</div>
                    <div class="fs-4 fw-bold text-dark mt-1">$@annualAvgPrice.ToString("N2") / L</div>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
            </div>
            <div class="small text-muted mt-2">Average price per litre in @selectedYear</div>
        </div>
    </div>
</div>

<!-- Monthly Breakdown Table Card -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-header bg-white border-bottom py-3">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-table me-2 text-primary"></i>Monthly Performance & Expenditure Breakdown
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Month</th>
                        <th class="text-center">Refill Transactions</th>
                        <th class="text-end">Volume Pumped (L)</th>
                        <th class="text-end">Average Price / L</th>
                        <th class="text-end">Total Expenditure ($)</th>
                        <th style="width: 25%;" class="pe-4">Annual Cost Share</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any(m => m.RefillCount > 0))
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-calendar-x fs-1 text-secondary d-block mb-2"></i>
                                No fuel expenses recorded in @selectedYear yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var sharePercent = annualCost > 0 ? (item.TotalCost / annualCost) * 100 : 0;
                            <tr class="@(item.RefillCount > 0 ? "" : "text-muted opacity-75")">
                                <td class="ps-4 fw-bold">
                                    <span class="badge bg-light text-dark border me-2">@item.Month.ToString("D2")</span>
                                    @item.MonthName
                                </td>
                                <td class="text-center">
                                    @if (item.RefillCount > 0)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold px-2 py-1">
                                            @item.RefillCount refills
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">&mdash;</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold">
                                    @(item.TotalQuantity > 0 ? $"{item.TotalQuantity:N1} L" : "0.0 L")
                                </td>
                                <td class="text-end">
                                    @(item.AveragePricePerLitre > 0 ? $"${item.AveragePricePerLitre:N2}" : "—")
                                </td>
                                <td class="text-end fw-bold text-success fs-6">
                                    $@item.TotalCost.ToString("N2")
                                </td>
                                <td class="pe-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @sharePercent.ToString("0.0")%" aria-valuenow="@sharePercent" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="small text-muted" style="min-width: 45px;">@sharePercent.ToString("0.0")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-light border-top border-2">
                    <tr class="fw-bold">
                        <td class="ps-4">Annual Total</td>
                        <td class="text-center">@annualRefills</td>
                        <td class="text-end">@annualQuantity.ToString("N1") L</td>
                        <td class="text-end">$@annualAvgPrice.ToString("N2")</td>
                        <td class="text-end text-success fs-5">$@annualCost.ToString("N2")</td>
                        <td class="pe-4">100.0%</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
