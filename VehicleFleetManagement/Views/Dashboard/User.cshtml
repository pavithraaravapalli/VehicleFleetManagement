@model VehicleFleetManagement.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "Staff Transportation Workspace";
}

<!-- Welcome Section & Hero Banner -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card card-modern p-4 p-md-4 shadow-sm border-0 position-relative overflow-hidden" style="background: linear-gradient(135deg, var(--fleet-navy) 0%, var(--fleet-navy-dark) 100%); color: #ffffff;">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
                
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="@Model.FullName" class="avatar-circle-lg" />
                    }
                    else
                    {
                        <div class="avatar-placeholder-lg bg-primary text-white fw-bold d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; font-size: 1.5rem; background-color: var(--fleet-primary) !important;">
                            @((Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "U"))
                        </div>
                    }

                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                            <h2 class="h3 fw-bold mb-0 text-white">Welcome back, @Model.FullName!</h2>
                            <span class="badge bg-primary text-white"><i class="bi bi-person-badge me-1"></i> Staff Account</span>
                        </div>

                        <div class="d-flex align-items-center flex-wrap gap-3 small text-white-50">
                            <span><i class="bi bi-envelope me-1"></i> @Model.Email</span>
                            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                            {
                                <span><i class="bi bi-telephone me-1"></i> @Model.PhoneNumber</span>
                            }
                            <span><i class="bi bi-calendar3 me-1"></i> Member since @Model.MemberSince.ToString("MMM yyyy")</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a asp-controller="TripRequests" asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm fw-semibold" style="background-color: var(--fleet-primary); border-color: var(--fleet-primary);">
                        <i class="bi bi-plus-circle me-2"></i> Request Transport
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-person-gear me-1"></i> My Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 4 Relevant Staff KPI Cards -->
<div class="row g-3 mb-4">
    <!-- 1. Pending Requests -->
    <div class="col-6 col-md-3">
        <a asp-controller="TripRequests" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom p-3 border-start border-warning border-4 h-100 hover-elevate">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pending Review</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.PendingRequestsCount</div>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-2">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Awaiting dispatch approval</div>
            </div>
        </a>
    </div>

    <!-- 2. Approved Requests -->
    <div class="col-6 col-md-3">
        <a asp-controller="TripRequests" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom p-3 border-start border-primary border-4 h-100 hover-elevate">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Approved Bookings</div>
                        <div class="fs-4 fw-bold text-primary mt-1">@Model.ApprovedRequestsCount</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2">
                        <i class="bi bi-clipboard2-check fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Ready for travel</div>
            </div>
        </a>
    </div>

    <!-- 3. Upcoming Journeys -->
    <div class="col-6 col-md-3">
        <a asp-controller="Trips" asp-action="UserTrips" class="text-decoration-none">
            <div class="card card-custom p-3 border-start border-info border-4 h-100 hover-elevate">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Upcoming Journeys</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.UpcomingTripsCount</div>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info rounded-circle p-2">
                        <i class="bi bi-signpost-2 fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Scheduled departures</div>
            </div>
        </a>
    </div>

    <!-- 4. Notifications -->
    <div class="col-6 col-md-3">
        <a asp-controller="Notifications" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom p-3 border-start border-secondary border-4 h-100 hover-elevate">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Notifications</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.UnreadNotificationsCount</div>
                    </div>
                    <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle p-2">
                        <i class="bi bi-bell fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    @(Model.UnreadNotificationsCount > 0 ? $"{Model.UnreadNotificationsCount} unread alert(s)" : "All caught up")
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Main Operational Layout -->
<div class="row g-4 mb-4">
    <!-- Left Column: My Requests & Upcoming Journeys -->
    <div class="col-12 col-lg-7">
        
        <!-- My Recent Transport Booking Requests -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clipboard2-check text-primary me-2"></i>My Booking Requests
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="TripRequests" asp-action="Create" class="btn btn-sm btn-primary py-1 px-2" style="background-color: var(--fleet-primary); border-color: var(--fleet-primary);">
                        <i class="bi bi-plus"></i> New Request
                    </a>
                    <a asp-controller="TripRequests" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All &rarr;</a>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.MyBookingRequests != null && Model.MyBookingRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Request #</th>
                                    <th>Route</th>
                                    <th>Departure</th>
                                    <th>Status</th>
                                    <th class="text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in Model.MyBookingRequests)
                                {
                                    var reqBadge = req.Status switch
                                    {
                                        "Approved" => "bg-primary",
                                        "Pending" => "bg-warning text-dark",
                                        "Rejected" => "bg-danger",
                                        _ => "bg-secondary"
                                    };

                                    <tr>
                                        <td class="ps-3 fw-bold text-dark small">
                                            #@req.TripRequestId
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-dark">@req.Source &rarr; @req.Destination</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">@req.PassengerCount passenger(s)</div>
                                        </td>
                                        <td class="small text-muted">
                                            @req.StartDate.ToString("MMM dd, HH:mm")
                                        </td>
                                        <td>
                                            <span class="badge @reqBadge">@req.Status</span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="TripRequests" asp-action="Details" asp-route-id="@req.TripRequestId" class="btn btn-sm btn-outline-secondary py-1 px-2" title="View Request Details">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-clipboard-plus fs-2 text-secondary d-block mb-2"></i>
                        <h6 class="fw-semibold text-dark small">No Booking Requests Submitted Yet</h6>
                        <p class="small text-muted mb-3">Need official transportation for an organizational journey?</p>
                        <a asp-controller="TripRequests" asp-action="Create" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-circle me-1"></i> Request Transport Now
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- My Upcoming Journeys -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-signpost-2 text-primary me-2"></i>My Upcoming Journeys
                </h6>
                <a asp-controller="Trips" asp-action="UserTrips" class="btn btn-sm btn-link text-decoration-none">View All &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (Model.MyUpcomingTrips != null && Model.MyUpcomingTrips.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Journey</th>
                                    <th>Vehicle & Driver</th>
                                    <th>Scheduled Time</th>
                                    <th>Status</th>
                                    <th class="text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trip in Model.MyUpcomingTrips)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <span class="fw-bold text-dark">@trip.Source &rarr; @trip.Destination</span>
                                            <div class="small text-muted">Trip #@trip.TripId</div>
                                        </td>
                                        <td class="small">
                                            <div><i class="bi bi-truck me-1 text-primary"></i>@(trip.Vehicle?.VehicleName ?? "Fleet Vehicle") (@(trip.Vehicle?.RegistrationNumber))</div>
                                            <div class="text-muted"><i class="bi bi-person me-1"></i>@(trip.Driver?.FullName ?? "Assigned Driver") (@(trip.Driver?.PhoneNumber))</div>
                                        </td>
                                        <td class="small text-muted">
                                            @trip.StartDate.ToString("MMM dd, yyyy HH:mm")
                                        </td>
                                        <td>
                                            @if (trip.TripStatus == "InProgress")
                                            {
                                                <span class="badge bg-primary">Active Journey</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Scheduled</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="Trips" asp-action="Details" asp-route-id="@trip.TripId" class="btn btn-sm btn-outline-primary py-1 px-2">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-geo-alt fs-1 text-secondary d-block mb-2"></i>
                        <h6 class="fw-semibold text-dark">No Upcoming Journeys</h6>
                        <p class="small text-muted mb-0">Once your transport requests are approved, your assigned journeys will appear here.</p>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- Right Column: Recent Completed Trips & Notifications -->
    <div class="col-12 col-lg-5">
        
        <!-- Recent Personal Notifications -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-bell-fill text-warning me-2"></i>Notifications
                </h6>
                <a asp-controller="Notifications" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Manage All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentNotifications != null && Model.RecentNotifications.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var n in Model.RecentNotifications)
                        {
                            <a href="@(n.ActionUrl ?? "/Notifications")" class="list-group-item list-group-item-action p-3 @(!n.IsRead ? "bg-light bg-opacity-75" : "")">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="fw-semibold small text-dark">
                                        @if (!n.IsRead)
                                        {
                                            <span class="badge bg-danger rounded-pill me-1" style="font-size: 0.65rem;">New</span>
                                        }
                                        @n.Title
                                    </span>
                                    <small class="text-muted" style="font-size: 0.7rem;">@n.CreatedAt.ToString("MMM dd")</small>
                                </div>
                                <p class="mb-0 text-muted small">@n.Message</p>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check2-circle fs-1 text-primary d-block mb-2"></i>
                        <h6 class="fw-semibold text-dark">You're All Caught Up!</h6>
                        <p class="small text-muted mb-0">No unread alerts for your account.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Trip History -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history text-secondary me-2"></i>Recent Trip History
                </h6>
                <a asp-controller="Trips" asp-action="UserTrips" asp-route-status="Completed" class="btn btn-sm btn-link text-decoration-none">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.MyCompletedTrips != null && Model.MyCompletedTrips.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var trip in Model.MyCompletedTrips)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark small">@trip.Source &rarr; @trip.Destination</span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Completed</span>
                                </div>
                                <div class="small text-muted d-flex justify-content-between align-items-center">
                                    <span>Driver: @(trip.Driver?.FullName ?? "Assigned Driver")</span>
                                    <span>@trip.Distance.ToString("N1") km</span>
                                </div>
                                <div class="mt-2 text-end">
                                    <a asp-controller="Trips" asp-action="Details" asp-route-id="@trip.TripId" class="btn btn-xs btn-outline-secondary">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-journal-check fs-2 text-secondary d-block mb-1"></i>
                        <p class="small text-muted mb-0">No completed journeys recorded yet.</p>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
