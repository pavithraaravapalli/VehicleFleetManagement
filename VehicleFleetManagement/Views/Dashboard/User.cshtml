@model VehicleFleetManagement.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "Staff Transportation Workspace";
}

<!-- Welcome Section & Hero Banner -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card card-modern p-4 p-md-4 shadow-sm border-0 position-relative overflow-hidden" style="background: linear-gradient(135deg, var(--fleet-navy) 0%, var(--fleet-navy-dark) 100%); color: #ffffff;">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
                
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="@Model.FullName" class="avatar-circle-lg" />
                    }
                    else
                    {
                        <div class="avatar-placeholder-lg">
                            @((Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "U"))
                        </div>
                    }

                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                            <h2 class="h3 fw-bold mb-0 text-white">Welcome back, @Model.FullName!</h2>
                            <span class="badge badge-status badge-available"><i class="bi bi-shield-check"></i> Staff Account Active</span>
                        </div>

                        <div class="d-flex align-items-center flex-wrap gap-3 small text-white-50">
                            <span><i class="bi bi-envelope me-1"></i> @Model.Email</span>
                            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                            {
                                <span><i class="bi bi-telephone me-1"></i> @Model.PhoneNumber</span>
                            }
                            <span><i class="bi bi-calendar3 me-1"></i> Member since @Model.MemberSince.ToString("MMM yyyy")</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="text-end d-none d-md-block me-2">
                        <small class="text-white-50 d-block">Today's Date</small>
                        <strong class="text-white">@DateTime.UtcNow.ToString("dddd, MMM dd, yyyy")</strong>
                    </div>
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-person-gear me-1"></i> My Profile
                    </a>
                    <a asp-controller="Notifications" asp-action="Index" class="btn btn-fleet-teal btn-sm rounded-pill px-3 position-relative">
                        <i class="bi bi-bell-fill me-1"></i> Notifications
                        @if (Model.UnreadNotificationsCount > 0)
                        {
                            <span class="badge bg-danger ms-1">@Model.UnreadNotificationsCount</span>
                        }
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3 Real SQL Server Database KPI Cards -->
<div class="row g-3 mb-4">
    <!-- 1. Available Transport Assets -->
    <div class="col-12 col-md-4">
        <a href="#available-vehicles" class="text-decoration-none">
            <div class="card card-custom p-3 border-start border-success border-4 h-100 hover-elevate">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Ready Transport Assets</div>
                        <div class="fs-3 fw-bold text-success mt-1">@Model.AvailableVehiclesCount</div>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3">
                        <i class="bi bi-truck fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Available for organizational journeys</div>
            </div>
        </a>
    </div>

    <!-- 2. Active & Scheduled Trips -->
    <div class="col-12 col-md-4">
        <a asp-controller="Trips" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom p-3 border-start border-primary border-4 h-100 hover-elevate">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Active / Scheduled Trips</div>
                        <div class="fs-3 fw-bold text-primary mt-1">@Model.ActiveTripsCount</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                        <i class="bi bi-geo-alt fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Scheduled fleet journeys across organization</div>
            </div>
        </a>
    </div>

    <!-- 3. Unread Notifications -->
    <div class="col-12 col-md-4">
        <a asp-controller="Notifications" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom p-3 border-start border-warning border-4 h-100 hover-elevate">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Alerts & Notifications</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.UnreadNotificationsCount</div>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                        <i class="bi bi-bell fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    @if (Model.UnreadNotificationsCount > 0)
                    {
                        <span class="text-danger fw-semibold">@Model.UnreadNotificationsCount unread alerts</span>
                    }
                    else
                    {
                        <span>All alerts caught up</span>
                    }
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Quick Action Shortcuts -->
<div class="row g-2 mb-4">
    <div class="col-6 col-md-3">
        <a href="#available-vehicles" class="btn btn-outline-secondary w-100 py-2 rounded-3 text-start d-flex align-items-center">
            <i class="bi bi-car-front fs-5 text-primary me-2"></i>
            <div>
                <strong class="d-block text-dark small">Available Fleet</strong>
                <small class="text-muted" style="font-size: 0.75rem;">Browse transport assets</small>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Trips" asp-action="Index" class="btn btn-outline-secondary w-100 py-2 rounded-3 text-start d-flex align-items-center">
            <i class="bi bi-signpost-2 fs-5 text-success me-2"></i>
            <div>
                <strong class="d-block text-dark small">Trip Schedules</strong>
                <small class="text-muted" style="font-size: 0.75rem;">View organizational routes</small>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Notifications" asp-action="Index" class="btn btn-outline-secondary w-100 py-2 rounded-3 text-start d-flex align-items-center">
            <i class="bi bi-bell fs-5 text-warning me-2"></i>
            <div>
                <strong class="d-block text-dark small">Notification Hub</strong>
                <small class="text-muted" style="font-size: 0.75rem;">Check operational notices</small>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary w-100 py-2 rounded-3 text-start d-flex align-items-center">
            <i class="bi bi-person-gear fs-5 text-info me-2"></i>
            <div>
                <strong class="d-block text-dark small">Account Settings</strong>
                <small class="text-muted" style="font-size: 0.75rem;">Update profile & password</small>
            </div>
        </a>
    </div>
</div>

<!-- Main Operational Layout -->
<div class="row g-4 mb-4">
    <!-- Left Column: Available Fleet Assets & Recent Journeys -->
    <div class="col-12 col-lg-7">
        
        <!-- Available Organizational Transport Assets -->
        <div class="card card-custom shadow-sm mb-4" id="available-vehicles">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-truck text-success me-2"></i>Available Fleet Transport Assets
                </h6>
                <span class="badge bg-success">@Model.AvailableVehiclesCount Ready</span>
            </div>
            <div class="card-body p-0">
                @if (Model.AvailableVehicles != null && Model.AvailableVehicles.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Vehicle</th>
                                    <th>Type</th>
                                    <th>Seating</th>
                                    <th>Fuel</th>
                                    <th class="text-end pe-3">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in Model.AvailableVehicles)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <span class="fw-bold text-dark">@v.VehicleName</span>
                                            <div class="small text-muted font-monospace">@v.RegistrationNumber</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@v.VehicleType</span>
                                        </td>
                                        <td class="small">
                                            <i class="bi bi-people me-1 text-muted"></i>@v.SeatingCapacity Seats
                                        </td>
                                        <td class="small text-muted">
                                            @v.FuelType
                                        </td>
                                        <td class="text-end pe-3">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Available</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-shield-check fs-1 text-secondary d-block mb-2"></i>
                        <h6 class="fw-semibold text-dark">No Vehicles Currently Available</h6>
                        <p class="small text-muted mb-0">All fleet vehicles are currently dispatched or undergoing maintenance.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Fleet Trips & Schedules -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-calendar-event text-primary me-2"></i>Recent Organizational Journeys
                </h6>
                <a asp-controller="Trips" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All Trips &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentTrips != null && Model.RecentTrips.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Route</th>
                                    <th>Vehicle & Driver</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th class="text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trip in Model.RecentTrips)
                                {
                                    string badgeClass = trip.TripStatus switch
                                    {
                                        "Completed" => "bg-success",
                                        "InProgress" => "bg-primary",
                                        "Scheduled" => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };

                                    <tr>
                                        <td class="ps-3">
                                            <span class="fw-bold text-dark">@trip.Source &rarr; @trip.Destination</span>
                                            <div class="small text-muted">Trip #@trip.TripId</div>
                                        </td>
                                        <td class="small">
                                            <div><i class="bi bi-truck me-1 text-muted"></i>@(trip.Vehicle?.VehicleName ?? "Fleet Vehicle")</div>
                                            <div class="text-muted"><i class="bi bi-person me-1"></i>@(trip.Driver?.FullName ?? "Assigned Driver")</div>
                                        </td>
                                        <td class="small text-muted">
                                            @trip.StartDate.ToString("MMM dd, yyyy")
                                        </td>
                                        <td>
                                            <span class="badge @badgeClass">@trip.TripStatus</span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="Trips" asp-action="Details" asp-route-id="@trip.TripId" class="btn btn-sm btn-outline-primary py-1 px-2 rounded-pill">
                                                Inspect
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-map fs-1 text-secondary d-block mb-2"></i>
                        <h6 class="fw-semibold text-dark">No Trip Records Found</h6>
                        <p class="small text-muted mb-0">No journeys have been scheduled yet.</p>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- Right Column: Recent Personal Notifications & Verified Reviews -->
    <div class="col-12 col-lg-5">
        
        <!-- Recent Personal Notifications -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-bell-fill text-warning me-2"></i>My Recent Notifications
                </h6>
                <a asp-controller="Notifications" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Manage All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentNotifications != null && Model.RecentNotifications.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var n in Model.RecentNotifications)
                        {
                            <a href="@(n.ActionUrl ?? "/Notifications")" class="list-group-item list-group-item-action p-3 @(!n.IsRead ? "bg-light bg-opacity-75" : "")">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="fw-semibold small text-dark">
                                        @if (!n.IsRead)
                                        {
                                            <span class="badge bg-danger rounded-pill me-1" style="font-size: 0.65rem;">New</span>
                                        }
                                        @n.Title
                                    </span>
                                    <small class="text-muted" style="font-size: 0.7rem;">@n.CreatedAt.ToString("MMM dd")</small>
                                </div>
                                <p class="mb-0 text-muted small">@n.Message</p>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check2-circle fs-1 text-success d-block mb-2"></i>
                        <h6 class="fw-semibold text-dark">You're All Caught Up!</h6>
                        <p class="small text-muted mb-0">No active alerts or notices for your account.</p>
                    </div>
                }
            </div>
        </div>

        <!-- My Submitted Driver Reviews -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-star-fill text-warning me-2"></i>My Driver Feedback
                </h6>
                <span class="badge bg-light text-secondary border">@Model.TotalReviewsWrittenCount Submitted</span>
            </div>
            <div class="card-body p-0">
                @if (Model.MyRecentReviews != null && Model.MyRecentReviews.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var review in Model.MyRecentReviews)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold small text-dark"><i class="bi bi-person-circle me-1"></i>@(review.Driver?.FullName ?? "Driver")</span>
                                    <span class="text-warning small">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted"></i>
                                            }
                                        }
                                    </span>
                                </div>
                                <p class="small text-muted mb-1 fst-italic">"@review.Comment"</p>
                                <div class="d-flex justify-content-between small text-muted" style="font-size: 0.75rem;">
                                    <span>Trip #@review.TripId (@review.Trip?.Source &rarr; @review.Trip?.Destination)</span>
                                    <span>@review.ReviewDate.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-chat-square-heart fs-1 text-secondary d-block mb-2"></i>
                        <h6 class="fw-semibold text-dark">No Reviews Submitted Yet</h6>
                        <p class="small text-muted mb-2">You can rate and review your driver on completed trips.</p>
                        <a asp-controller="Trips" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">
                            Browse Trips to Review
                        </a>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
