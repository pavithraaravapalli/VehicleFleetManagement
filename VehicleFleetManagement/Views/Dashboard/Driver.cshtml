@model VehicleFleetManagement.ViewModels.DriverDashboardViewModel
@{
    ViewData["Title"] = "Driver Workspace - FleetFlow Pro";
}

<!-- Welcome Section & Driver Profile Hero Banner -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card card-modern p-4 p-md-4 shadow-sm border-0 position-relative overflow-hidden" style="background: linear-gradient(135deg, var(--fleet-navy-dark) 0%, var(--fleet-navy) 100%); color: #ffffff;">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
                
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="@Model.DriverName" class="avatar-circle-lg" />
                    }
                    else
                    {
                        <div class="avatar-placeholder-lg">
                            @((Model.DriverName.Length > 0 ? Model.DriverName[0].ToString().ToUpper() : "D"))
                        </div>
                    }

                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                            <h2 class="h3 fw-bold mb-0 text-white">Welcome back, @Model.DriverName!</h2>
                            @if (Model.AvailabilityStatus == "Available")
                            {
                                <span class="badge badge-status badge-available"><i class="bi bi-circle-fill" style="font-size: 6px;"></i> Available for Dispatch</span>
                            }
                            else if (Model.AvailabilityStatus == "OnTrip")
                            {
                                <span class="badge badge-status badge-ontrip"><i class="bi bi-truck"></i> On Active Trip</span>
                            }
                            else if (Model.AvailabilityStatus == "OnLeave")
                            {
                                <span class="badge badge-status badge-onleave"><i class="bi bi-calendar-event"></i> On Leave</span>
                            }
                            else
                            {
                                <span class="badge badge-status badge-unavailable"><i class="bi bi-slash-circle"></i> Unavailable</span>
                            }
                        </div>

                        <div class="d-flex align-items-center flex-wrap gap-3 small text-white-50">
                            <span><i class="bi bi-credit-card-2-front me-1"></i> License: <strong class="text-white">@Model.LicenseNumber</strong></span>
                            <span><i class="bi bi-telephone me-1"></i> @Model.PhoneNumber</span>
                            <span class="d-flex align-items-center star-rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.Rating))
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-white-50"></i>
                                    }
                                }
                                <strong class="text-white ms-1">@Model.Rating.ToString("N1")</strong>
                                <span class="text-white-50 ms-1">(@Model.TotalReviews reviews)</span>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Quick Availability & Profile Actions -->
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-light btn-sm px-3 rounded-pill" data-bs-toggle="modal" data-bs-target="#availabilityModal">
                        <i class="bi bi-sliders me-1"></i> Change Status
                    </button>
                    <a asp-controller="Drivers" asp-action="Profile" class="btn btn-fleet-primary btn-sm px-3 rounded-pill">
                        <i class="bi bi-person-circle me-1"></i> My Profile
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- 6 Statistical KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-2">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold d-block">Trips Done</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalTripsCompleted</h3>
                </div>
                <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
            <small class="text-success mt-1 d-block"><i class="bi bi-arrow-up-short"></i> All-time</small>
        </div>
    </div>

    <div class="col-6 col-lg-2">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold d-block">In Progress</span>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TripsInProgress</h3>
                </div>
                <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-truck"></i>
                </div>
            </div>
            <small class="text-muted mt-1 d-block">Active journey</small>
        </div>
    </div>

    <div class="col-6 col-lg-2">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold d-block">Upcoming</span>
                    <h3 class="fw-bold mb-0 text-info">@Model.UpcomingTripsCount</h3>
                </div>
                <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info">
                    <i class="bi bi-calendar3"></i>
                </div>
            </div>
            <small class="text-muted mt-1 d-block">Scheduled</small>
        </div>
    </div>

    <div class="col-6 col-lg-2">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold d-block">Total Distance</span>
                    <h4 class="fw-bold mb-0 text-dark text-truncate">@Model.TotalDistanceTravelled.ToString("N0") <span class="fs-6 fw-normal text-muted">km</span></h4>
                </div>
                <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-speedometer"></i>
                </div>
            </div>
            <small class="text-muted mt-1 d-block">Recorded log</small>
        </div>
    </div>

    <div class="col-6 col-lg-2">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold d-block">This Month</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.CurrentMonthTripsCount</h3>
                </div>
                <div class="stat-icon-wrapper bg-teal bg-opacity-10 text-teal" style="color: var(--fleet-teal); background-color: var(--fleet-teal-subtle);">
                    <i class="bi bi-signpost-2"></i>
                </div>
            </div>
            <small class="text-muted mt-1 d-block">@Model.CurrentMonthDistance.ToString("N0") km covered</small>
        </div>
    </div>

    <div class="col-6 col-lg-2">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold d-block">Driver Rating</span>
                    <h3 class="fw-bold mb-0 text-warning">@Model.Rating.ToString("N1") <span class="fs-6 text-muted">/ 5</span></h3>
                </div>
                <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-star-fill"></i>
                </div>
            </div>
            <small class="text-muted mt-1 d-block">@Model.TotalReviews reviews</small>
        </div>
    </div>
</div>

<!-- Quick Action Shortcuts Bar -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card card-modern p-3 bg-white shadow-sm border-0 rounded-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <span class="fw-bold small text-dark"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Operations:</span>
                <div class="d-flex gap-2 flex-wrap">
                    @if (Model.CurrentActiveTrip != null)
                    {
                        <a asp-controller="Trips" asp-action="Complete" asp-route-id="@Model.CurrentActiveTrip.TripId" class="btn btn-success btn-sm px-3 rounded-pill">
                            <i class="bi bi-flag-fill me-1"></i> Conclude Active Trip
                        </a>
                    }
                    else if (Model.UpcomingTimelineTrips.Any())
                    {
                        var nextTrip = Model.UpcomingTimelineTrips.First();
                        <a asp-controller="Trips" asp-action="Start" asp-route-id="@nextTrip.TripId" class="btn btn-primary btn-sm px-3 rounded-pill">
                            <i class="bi bi-play-circle-fill me-1"></i> Start Next Journey (#@nextTrip.TripId)
                        </a>
                    }
                    
                    <a asp-controller="Fuel" asp-action="Create" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                        <i class="bi bi-fuel-pump me-1"></i> Log Fuel Refill
                    </a>
                    <a asp-controller="Issues" asp-action="Create" class="btn btn-outline-danger btn-sm px-3 rounded-pill">
                        <i class="bi bi-exclamation-triangle me-1"></i> Report Vehicle Fault
                    </a>
                    <a asp-controller="Trips" asp-action="MyTrips" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                        <i class="bi bi-list-task me-1"></i> All Assigned Trips
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Active Journey & Vehicle Spotlight Card -->
    <div class="col-12 col-lg-8">
        @if (Model.CurrentActiveTrip != null)
        {
            <div class="card card-modern border-primary border-2 p-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-primary px-3 py-2 rounded-pill"><i class="bi bi-truck me-1"></i> CURRENT IN-PROGRESS JOURNEY</span>
                    <span class="text-muted small">Started: @(Model.CurrentActiveTrip.ActualStartDate?.ToString("g") ?? Model.CurrentActiveTrip.StartDate.ToString("g"))</span>
                </div>
                <div class="row g-3 align-items-center">
                    <div class="col-md-7">
                        <h4 class="fw-bold text-dark mb-1">
                            @Model.CurrentActiveTrip.Source &rarr; @Model.CurrentActiveTrip.Destination
                        </h4>
                        <p class="text-muted small mb-2"><i class="bi bi-info-circle me-1"></i> Purpose: @Model.CurrentActiveTrip.Purpose</p>
                        <div class="d-flex gap-3 small">
                            <span><i class="bi bi-truck me-1 text-primary"></i> <strong>@Model.CurrentActiveTrip.Vehicle?.VehicleName</strong> (@Model.CurrentActiveTrip.Vehicle?.RegistrationNumber)</span>
                            <span><i class="bi bi-speedometer2 me-1"></i> Start Odometer: <strong>@Model.CurrentActiveTrip.StartOdometer.ToString("N1") km</strong></span>
                        </div>
                    </div>
                    <div class="col-md-5 text-md-end">
                        <a asp-controller="Trips" asp-action="Complete" asp-route-id="@Model.CurrentActiveTrip.TripId" class="btn btn-success px-4 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Complete Trip & Log Odometer
                        </a>
                    </div>
                </div>
            </div>
        }

        <!-- My Trips Table Section -->
        <div class="card card-modern shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-geo-alt-fill me-2 text-primary"></i> My Assigned Journeys
                </h5>
                <a asp-controller="Trips" asp-action="MyTrips" class="btn btn-sm btn-outline-secondary rounded-pill">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase">
                            <tr>
                                <th class="ps-3">Trip #</th>
                                <th>Vehicle</th>
                                <th>Origin &rarr; Destination</th>
                                <th>Schedule</th>
                                <th>Distance</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AssignedTrips.Any())
                            {
                                foreach (var trip in Model.AssignedTrips)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-dark">#@trip.TripId</td>
                                        <td>
                                            <div class="fw-semibold small">@trip.Vehicle?.VehicleName</div>
                                            <span class="badge bg-light text-secondary border">@trip.Vehicle?.RegistrationNumber</span>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-dark">@trip.Source</div>
                                            <div class="small text-muted">&darr; @trip.Destination</div>
                                        </td>
                                        <td class="small">
                                            <div>@trip.StartDate.ToString("MMM dd, yyyy")</div>
                                            <span class="text-muted">@trip.StartDate.ToString("HH:mm")</span>
                                        </td>
                                        <td class="small">
                                            @if (trip.Distance > 0)
                                            {
                                                <span class="fw-semibold text-dark">@trip.Distance.ToString("N1") km</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (trip.TripStatus == "Completed")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small rounded-pill">Completed</span>
                                            }
                                            else if (trip.TripStatus == "InProgress")
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small rounded-pill">In Progress</span>
                                            }
                                            else if (trip.TripStatus == "Scheduled")
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 small rounded-pill">Scheduled</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1 small rounded-pill">@trip.TripStatus</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group btn-group-sm">
                                                @if (trip.TripStatus == "Scheduled")
                                                {
                                                    <a asp-controller="Trips" asp-action="Start" asp-route-id="@trip.TripId" class="btn btn-outline-primary" title="Start Journey">
                                                        <i class="bi bi-play-fill"></i>
                                                    </a>
                                                }
                                                else if (trip.TripStatus == "InProgress")
                                                {
                                                    <a asp-controller="Trips" asp-action="Complete" asp-route-id="@trip.TripId" class="btn btn-outline-success" title="Complete Journey">
                                                        <i class="bi bi-check-lg"></i>
                                                    </a>
                                                }
                                                <a asp-controller="Trips" asp-action="Details" asp-route-id="@trip.TripId" class="btn btn-outline-secondary" title="Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted small">
                                        <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                        No trips currently assigned.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Monthly Distance Travelled Chart (Chart.js) -->
        <div class="card card-modern p-4 shadow-sm border-0 mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i> Monthly Distance Covered (Last 6 Months)</h6>
                <span class="badge bg-light text-muted border">Telemetry</span>
            </div>
            <div style="height: 220px;">
                <canvas id="driverDistanceChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Right Sidebar Column: Assigned Vehicle, Upcoming Timeline & Faults -->
    <div class="col-12 col-lg-4">
        
        <!-- Assigned Vehicle Spotlight -->
        @if (Model.ActiveVehicle != null)
        {
            <div class="card card-modern p-4 shadow-sm border-0 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-car-front-fill text-primary me-2"></i> Assigned Vehicle</h6>
                    <span class="badge bg-success-subtle text-success small rounded-pill">@Model.ActiveVehicle.Status</span>
                </div>
                <div class="text-center py-2 border-bottom mb-3">
                    <h5 class="fw-bold text-dark mb-0">@Model.ActiveVehicle.VehicleName</h5>
                    <span class="badge bg-navy text-white px-3 py-1 mt-1" style="background-color: var(--fleet-navy);">@Model.ActiveVehicle.RegistrationNumber</span>
                </div>
                <div class="row g-2 small text-muted">
                    <div class="col-6">
                        <span class="d-block text-secondary">Model:</span>
                        <strong class="text-dark">@Model.ActiveVehicle.Model</strong>
                    </div>
                    <div class="col-6">
                        <span class="d-block text-secondary">Fuel Type:</span>
                        <strong class="text-dark">@Model.ActiveVehicle.FuelType</strong>
                    </div>
                    <div class="col-6">
                        <span class="d-block text-secondary">Current Odo:</span>
                        <strong class="text-dark">@Model.ActiveVehicle.CurrentOdometer.ToString("N0") km</strong>
                    </div>
                    <div class="col-6">
                        <span class="d-block text-secondary">Type:</span>
                        <strong class="text-dark">@Model.ActiveVehicle.VehicleType</strong>
                    </div>
                </div>

                @if (Model.ActiveVehicleMaintenanceAlerts.Any())
                {
                    <div class="mt-3 pt-3 border-top">
                        <div class="fw-bold small text-danger mb-2"><i class="bi bi-tools me-1"></i> Maintenance Reminders:</div>
                        @foreach (var alert in Model.ActiveVehicleMaintenanceAlerts)
                        {
                            <div class="p-2 mb-1 rounded bg-warning bg-opacity-10 small text-dark d-flex justify-content-between align-items-center">
                                <span>@alert.ServiceType</span>
                                <small class="text-muted">@alert.NextServiceDate.ToString("MMM dd")</small>
                            </div>
                        }
                    </div>
                }

                <div class="mt-3 pt-2 d-flex gap-2">
                    <a asp-controller="Issues" asp-action="Create" asp-route-vehicleId="@Model.ActiveVehicle.VehicleId" class="btn btn-outline-danger btn-sm w-100 rounded-pill">
                        <i class="bi bi-exclamation-triangle me-1"></i> Report Fault
                    </a>
                </div>
            </div>
        }

        <!-- Upcoming Trips Timeline -->
        <div class="card card-modern p-4 shadow-sm border-0 mb-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history text-info me-2"></i> Scheduled Timeline</h6>
            @if (Model.UpcomingTimelineTrips.Any())
            {
                <div class="timeline ps-2 border-start border-2 border-info">
                    @foreach (var trip in Model.UpcomingTimelineTrips)
                    {
                        <div class="position-relative mb-3 ps-3">
                            <span class="position-absolute top-0 start-0 translate-middle p-1 bg-info border border-light rounded-circle"></span>
                            <div class="small fw-bold text-dark">@trip.Source &rarr; @trip.Destination</div>
                            <small class="text-muted d-block">@trip.StartDate.ToString("MMM dd, yyyy HH:mm")</small>
                            <small class="text-secondary">Vehicle: @trip.Vehicle?.RegistrationNumber</small>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-3 text-muted small">
                    <i class="bi bi-calendar-check fs-3 d-block mb-1 text-success"></i>
                    No pending trips scheduled.
                </div>
            }
        </div>

        <!-- Recent Vehicle Faults Reported -->
        <div class="card card-modern p-4 shadow-sm border-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-wrench-adjustable text-danger me-2"></i> Reported Faults</h6>
                <a asp-controller="Issues" asp-action="Create" class="btn btn-sm btn-link p-0 text-decoration-none">Report</a>
            </div>
            @if (Model.RecentReportedIssues.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var issue in Model.RecentReportedIssues)
                    {
                        <div class="list-group-item px-0 py-2 border-bottom">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold small text-dark">@issue.Title</span>
                                <span class="badge @(issue.Status == "Resolved" ? "bg-success" : "bg-warning text-dark")" style="font-size: 0.65rem;">@issue.Status</span>
                            </div>
                            <small class="text-muted d-block">@issue.Vehicle?.RegistrationNumber &bull; @issue.Category &bull; @issue.ReportDate.ToString("MMM dd")</small>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-3 text-muted small">
                    <i class="bi bi-shield-check fs-3 d-block mb-1 text-success"></i>
                    No vehicle faults reported.
                </div>
            }
        </div>

    </div>
</div>

<!-- Driver Availability Status Modal -->
<div class="modal fade" id="availabilityModal" tabindex="-1" aria-labelledby="availabilityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold text-dark" id="availabilityModalLabel">
                    <i class="bi bi-sliders text-primary me-2"></i> Update Availability Status
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Drivers" asp-action="UpdateAvailability" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="driverId" value="@Model.DriverId" />
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Select your current dispatch readiness. Note: You cannot mark yourself as available or on leave while driving an active in-progress trip.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Current Status</label>
                        <select name="status" class="form-select" required>
                            <option value="Available" selected="@(Model.AvailabilityStatus == "Available")">Available (Ready for trip assignments)</option>
                            <option value="Unavailable" selected="@(Model.AvailabilityStatus == "Unavailable")">Unavailable (Off-duty / Resting)</option>
                            <option value="OnLeave" selected="@(Model.AvailabilityStatus == "OnLeave")">On Leave (Approved absence)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Reason / Notes (Optional)</label>
                        <input type="text" name="reason" class="form-control" placeholder="e.g. Taking scheduled weekly leave" maxlength="250" />
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-fleet-primary rounded-pill px-4">Update Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Chart.js Monthly Travel Distance Bar Chart
            const ctx = document.getElementById('driverDistanceChart');
            if (ctx) {
                const months = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DistanceChartMonths));
                const distances = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DistanceChartKm));

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: months,
                        datasets: [{
                            label: 'Kilometres Covered (km)',
                            data: distances,
                            backgroundColor: 'rgba(13, 148, 136, 0.75)',
                            borderColor: 'rgb(13, 148, 136)',
                            borderWidth: 1.5,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: '#f1f5f9' },
                                ticks: { font: { size: 11 } }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { size: 11 } }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.parsed.y.toLocaleString() + ' km travelled';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
