@model VehicleFleetManagement.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Operations Dashboard";
}

<!-- Page Header & Key Actions -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--fleet-navy);">Operations Dashboard</h2>
        <p class="text-muted small mb-0">Overview of fleet inventory, active journeys, and pending transport requests</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Vehicles" asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm" style="background-color: var(--fleet-primary); border-color: var(--fleet-primary);">
            <i class="bi bi-plus-circle me-1"></i> Add Vehicle
        </a>
        <a asp-controller="Trips" asp-action="Create" class="btn btn-outline-primary btn-sm px-3">
            <i class="bi bi-signpost-2 me-1"></i> Dispatch Trip
        </a>
        <a asp-controller="TripRequests" asp-action="Manage" class="btn btn-outline-secondary btn-sm px-3 position-relative">
            <i class="bi bi-clipboard-check me-1"></i> Booking Requests
            @if (Model.PendingTripRequestsCount > 0)
            {
                <span class="badge bg-danger rounded-pill ms-1">@Model.PendingTripRequestsCount</span>
            }
        </a>
    </div>
</div>

<!-- Essential KPI Metric Cards (Clean 4-Card Row) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-primary border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Total Fleet</div>
            <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalVehicles</div>
            <div class="small text-muted mt-auto pt-1">Registered Vehicles</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-primary border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Ready for Dispatch</div>
            <div class="fs-3 fw-bold text-primary mt-1">@Model.AvailableVehicles</div>
            <div class="small text-muted mt-auto pt-1">Available Vehicles</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-warning border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Active Journeys</div>
            <div class="fs-3 fw-bold text-dark mt-1">@Model.ActiveTrips</div>
            <div class="small text-muted mt-auto pt-1">In Transit / Scheduled</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-secondary border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Pending Requests</div>
            <div class="fs-3 fw-bold text-dark mt-1">@Model.PendingTripRequestsCount</div>
            <div class="small text-muted mt-auto pt-1">Awaiting Approval</div>
        </div>
    </div>
</div>

<!-- Main Operational Grid -->
<div class="row g-4">
    <!-- Left Column: Recent Trips & Pending Booking Requests -->
    <div class="col-12 col-lg-7">
        
        <!-- Recent Trip Dispatches -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history text-primary me-2"></i>Recent Trip Dispatches
                </h6>
                <a asp-controller="Trips" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentTrips != null && Model.RecentTrips.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Route</th>
                                    <th>Vehicle & Driver</th>
                                    <th>Status</th>
                                    <th>Departure</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trip in Model.RecentTrips)
                                {
                                    string badgeClass = trip.TripStatus switch
                                    {
                                        "Completed" => "bg-secondary",
                                        "InProgress" => "bg-primary",
                                        "Scheduled" => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };
                                    <tr>
                                        <td class="ps-3">
                                            <span class="fw-semibold text-dark">@trip.Source &rarr; @trip.Destination</span>
                                            <div class="small text-muted">Trip #@trip.TripId</div>
                                        </td>
                                        <td class="small">
                                            <div><i class="bi bi-truck me-1 text-muted"></i>@(trip.Vehicle?.RegistrationNumber ?? "N/A")</div>
                                            <div class="text-muted"><i class="bi bi-person me-1"></i>@(trip.Driver?.FullName ?? "N/A")</div>
                                        </td>
                                        <td>
                                            <span class="badge @badgeClass">@trip.TripStatus</span>
                                        </td>
                                        <td class="small text-muted">
                                            @trip.StartDate.ToString("MMM dd, yyyy")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-signpost-2 fs-1 text-secondary d-block mb-2"></i>
                        <h6 class="fw-semibold text-dark">No Trips Dispatched Yet</h6>
                        <p class="small text-muted mb-3">Schedule your first official journey by assigning a vehicle and driver.</p>
                        <a asp-controller="Trips" asp-action="Create" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-plus-circle me-1"></i> Dispatch First Trip
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Pending Transport Requests -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clipboard2-check text-primary me-2"></i>Staff Transport Requests
                </h6>
                <a asp-controller="TripRequests" asp-action="Manage" class="btn btn-sm btn-link text-decoration-none">Manage All &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentTripRequests != null && Model.RecentTripRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Requester</th>
                                    <th>Route</th>
                                    <th>Schedule</th>
                                    <th>Status</th>
                                    <th class="text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in Model.RecentTripRequests)
                                {
                                    var reqBadge = req.Status switch
                                    {
                                        "Approved" => "bg-primary",
                                        "Pending" => "bg-warning text-dark",
                                        "Rejected" => "bg-danger",
                                        _ => "bg-secondary"
                                    };

                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-semibold text-dark small">@(req.User?.FullName ?? "Staff")</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">@req.User?.Email</div>
                                        </td>
                                        <td>
                                            <div class="small text-dark">@req.Source &rarr; @req.Destination</div>
                                            <div class="text-muted" style="font-size: 0.7rem;">@req.PassengerCount pax</div>
                                        </td>
                                        <td class="small text-muted">
                                            @req.StartDate.ToString("MMM dd, HH:mm")
                                        </td>
                                        <td>
                                            <span class="badge @reqBadge">@req.Status</span>
                                        </td>
                                        <td class="text-end pe-3">
                                            @if (req.Status == "Pending")
                                            {
                                                <a asp-controller="TripRequests" asp-action="Approve" asp-route-id="@req.TripRequestId" class="btn btn-sm btn-primary py-1 px-2" style="background-color: var(--fleet-primary); border-color: var(--fleet-primary);">
                                                    Approve
                                                </a>
                                            }
                                            <a asp-controller="TripRequests" asp-action="Details" asp-route-id="@req.TripRequestId" class="btn btn-sm btn-outline-secondary py-1 px-2">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-check2-circle fs-2 text-primary d-block mb-1"></i>
                        <p class="small text-muted mb-0">No pending transport requests at this time.</p>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- Right Column: Fleet Status & Service Reminders -->
    <div class="col-12 col-lg-5">
        
        <!-- Fleet Status Breakdown -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart text-primary me-2"></i>Fleet Status
                </h6>
                <a asp-controller="Vehicles" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Vehicles &rarr;</a>
            </div>
            <div class="card-body p-3">
                @if (Model.TotalVehicles > 0)
                {
                    <div style="height: 200px; width: 100%;">
                        <canvas id="vehicleStatusChart"></canvas>
                    </div>
                    <div class="d-flex justify-content-around text-center mt-3 pt-2 border-top small">
                        <div>
                            <strong class="text-primary d-block fs-6">@Model.AvailableVehicles</strong>
                            <span class="text-muted" style="font-size: 0.75rem;">Available</span>
                        </div>
                        <div>
                            <strong class="text-warning d-block fs-6">@Model.AssignedVehicles</strong>
                            <span class="text-muted" style="font-size: 0.75rem;">On Trip</span>
                        </div>
                        <div>
                            <strong class="text-danger d-block fs-6">@Model.UnderMaintenanceVehicles</strong>
                            <span class="text-muted" style="font-size: 0.75rem;">In Service</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-truck fs-1 text-secondary d-block mb-2"></i>
                        <h6 class="fw-semibold text-dark">Fleet is Empty</h6>
                        <p class="small text-muted mb-3">Add vehicles to view fleet status and availability breakdowns.</p>
                        <a asp-controller="Vehicles" asp-action="Create" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-plus-circle me-1"></i> Add Vehicle
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Maintenance & Service Queue -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-tools text-primary me-2"></i>Maintenance Reminders
                </h6>
                <a asp-controller="Maintenance" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UpcomingMaintenanceAlerts != null && Model.UpcomingMaintenanceAlerts.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var m in Model.UpcomingMaintenanceAlerts.Take(4))
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-dark small">@(m.Vehicle?.VehicleName ?? "Vehicle")</strong>
                                    <span class="badge bg-warning text-dark">@m.ServiceType</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center small text-muted">
                                    <span>Reg: @(m.Vehicle?.RegistrationNumber)</span>
                                    <span>Due: @m.ServiceDate.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-shield-check fs-2 text-primary d-block mb-1"></i>
                        <p class="small text-muted mb-0">No upcoming service due within the next 7 days.</p>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            var statusCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VehicleStatusCounts));
            if (statusCounts && statusCounts.length > 0 && statusCounts.some(c => c > 0)) {
                var statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VehicleStatusLabels));
                var ctx = document.getElementById('vehicleStatusChart').getContext('2d');
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: statusLabels,
                        datasets: [{
                            data: statusCounts,
                            backgroundColor: ['#2563EB', '#F59E0B', '#EF4444'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }
        });
    </script>
}
