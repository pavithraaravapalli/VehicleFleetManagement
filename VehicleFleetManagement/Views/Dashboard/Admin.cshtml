@model VehicleFleetManagement.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Fleet Operations Control Center";
}

<!-- Top Header & Dispatch Actions -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: #172554;">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Fleet Operations Control Center
        </h2>
        <p class="text-muted small mb-0">Real-time asset telemetry, workforce allocation, and business intelligence metrics</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Trips" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-signpost-2 me-1"></i> Dispatch Trip
        </a>
        <a asp-controller="Vehicles" asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-truck me-1"></i> Add Vehicle
        </a>
        <a asp-controller="Drivers" asp-action="Create" class="btn btn-outline-secondary">
            <i class="bi bi-person-plus me-1"></i> Register Driver
        </a>
        <a asp-controller="Issues" asp-action="Index" class="btn btn-outline-danger position-relative">
            <i class="bi bi-shield-exclamation me-1"></i> Defect Reports
            @if (Model.OpenVehicleIssuesCount > 0)
            {
                <span class="badge bg-danger ms-1">@Model.OpenVehicleIssuesCount</span>
            }
        </a>
        <a asp-controller="Reports" asp-action="Index" class="btn text-white shadow-sm" style="background-color: #0D9488;">
            <i class="bi bi-bar-chart-line-fill me-1"></i> Reports Hub
        </a>
    </div>
</div>

<!-- Proactive Maintenance Due Alert Banner (if any) -->
@if (Model.UpcomingMaintenanceAlertsCount > 0)
{
    <div class="alert alert-warning border-warning shadow-sm d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-3 text-warning me-3"></i>
            <div>
                <strong class="d-block text-dark">Attention Required: @Model.UpcomingMaintenanceAlertsCount Vehicle(s) Due for Servicing</strong>
                <span class="small text-muted">Proactive maintenance reminders within the upcoming 7 days. Inspect to prevent unscheduled road breakdowns.</span>
            </div>
        </div>
        <a asp-controller="Maintenance" asp-action="Index" class="btn btn-sm btn-outline-dark">
            <i class="bi bi-tools me-1"></i> Review Maintenance Queue
        </a>
    </div>
}

<!-- Key Operational Statistics - Row 1: Fleet Assets & Dispatch Telemetry -->
<div class="row g-3 mb-3">
    <!-- 1. Total Vehicles -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card card-custom p-3 border-start border-primary border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Total Fleet</div>
            <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalVehicles</div>
            <div class="small text-muted mt-auto pt-1">Registered Assets</div>
        </div>
    </div>

    <!-- 2. Available Vehicles -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card card-custom p-3 border-start border-success border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Available</div>
            <div class="fs-4 fw-bold text-success mt-1">@Model.AvailableVehicles</div>
            <div class="small text-muted mt-auto pt-1">Ready for Dispatch</div>
        </div>
    </div>

    <!-- 3. Assigned Vehicles -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card card-custom p-3 border-start border-warning border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Assigned / Busy</div>
            <div class="fs-4 fw-bold text-warning mt-1">@Model.AssignedVehicles</div>
            <div class="small text-muted mt-auto pt-1">On Active Journey</div>
        </div>
    </div>

    <!-- 4. Under Maintenance -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card card-custom p-3 border-start border-danger border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">In Maintenance</div>
            <div class="fs-4 fw-bold text-danger mt-1">@Model.UnderMaintenanceVehicles</div>
            <div class="small text-muted mt-auto pt-1">Garage Servicing</div>
        </div>
    </div>

    <!-- 5. Active Trips -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card card-custom p-3 border-start border-info border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Active Trips</div>
            <div class="fs-4 fw-bold text-info mt-1">@Model.ActiveTrips</div>
            <div class="small text-muted mt-auto pt-1">In Transit Now</div>
        </div>
    </div>

    <!-- 6. Open Vehicle Faults -->
    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Issues" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom p-3 border-start border-danger border-4 h-100 shadow-sm">
                <div class="text-muted small fw-semibold text-uppercase">Vehicle Defects</div>
                <div class="fs-4 fw-bold text-danger mt-1">@Model.OpenVehicleIssuesCount</div>
                <div class="small text-danger mt-auto pt-1"><i class="bi bi-shield-exclamation me-1"></i>Open Tickets</div>
            </div>
        </a>
    </div>
</div>

<!-- Key Operational Statistics - Row 2: Workforce & Financial Metrics -->
<div class="row g-3 mb-4">
    <!-- 7. Total Drivers & Availability Breakdown -->
    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Drivers" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom p-3 border-start border-secondary border-4 h-100">
                <div class="text-muted small fw-semibold text-uppercase">Fleet Drivers</div>
                <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalDrivers</div>
                <div class="small text-muted mt-auto pt-1">
                    <span class="text-success fw-bold">@Model.AvailableDriversCount</span> Ready | 
                    <span class="text-primary fw-bold">@Model.OnTripDriversCount</span> Busy
                </div>
            </div>
        </a>
    </div>

    <!-- 8. Completed Trips -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card card-custom p-3 border-start border-success border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Completed</div>
            <div class="fs-4 fw-bold text-dark mt-1">@Model.CompletedTrips</div>
            <div class="small text-muted mt-auto pt-1">Logged Journeys</div>
        </div>
    </div>

    <!-- 9. Pending Trips -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card card-custom p-3 border-start border-secondary border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Pending / Scheduled</div>
            <div class="fs-4 fw-bold text-dark mt-1">@Model.PendingTrips</div>
            <div class="small text-muted mt-auto pt-1">Awaiting Departure</div>
        </div>
    </div>

    <!-- 10. Total Fuel Expenses -->
    <div class="col-6 col-md-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-primary border-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Fuel Expenses</div>
                    <div class="fs-4 fw-bold text-primary mt-1">$@Model.TotalFuelExpenses.ToString("N2")</div>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2">
                    <i class="bi bi-fuel-pump fs-4"></i>
                </div>
            </div>
            <div class="small text-muted mt-1">Cumulative Fuel Procurement</div>
        </div>
    </div>

    <!-- 11. Maintenance Expenses -->
    <div class="col-6 col-md-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-dark border-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Maintenance Costs</div>
                    <div class="fs-4 fw-bold text-dark mt-1">$@Model.TotalMaintenanceExpenses.ToString("N2")</div>
                </div>
                <div class="bg-dark bg-opacity-10 text-dark rounded-circle p-2">
                    <i class="bi bi-tools fs-4"></i>
                </div>
            </div>
            <div class="small text-muted mt-1">Total Service Invoices</div>
        </div>
    </div>
</div>

<!-- Visual Analytics Charts Row (Powered by Chart.js) -->
<div class="row g-3 mb-4">
    <!-- Fleet Allocation Doughnut Chart -->
    <div class="col-12 col-lg-4">
        <div class="card card-custom shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart-fill text-primary me-2"></i>Fleet Availability Allocation
                </h6>
            </div>
            <div class="card-body d-flex flex-column justify-content-center align-items-center p-3">
                <div style="height: 230px; width: 100%;">
                    <canvas id="vehicleStatusChart"></canvas>
                </div>
                <div class="mt-3 text-center small text-muted">
                    Proportion of vehicles in service, available, or undergoing repairs.
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Operational Cost Trends Bar Chart -->
    <div class="col-12 col-lg-8">
        <div class="card card-custom shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-bar-chart-fill text-success me-2"></i>Monthly Operational Expenses (Fuel vs Maintenance)
                </h6>
                <span class="badge bg-light text-secondary border">Last 6 Months</span>
            </div>
            <div class="card-body p-3">
                <div style="height: 250px; width: 100%;">
                    <canvas id="monthlyExpenseChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Operational Feeds: Active Maintenance Reminders & Recent Trips -->
<div class="row g-3 mb-4">
    <!-- Active Maintenance Alerts Table -->
    <div class="col-12 col-lg-6">
        <div class="card card-custom shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-bell-fill text-warning me-2"></i>Upcoming Maintenance Due (Next 7 Days)
                </h6>
                <a asp-controller="Maintenance" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UpcomingMaintenanceAlerts != null && Model.UpcomingMaintenanceAlerts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Vehicle</th>
                                    <th>Service Type</th>
                                    <th>Service Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.UpcomingMaintenanceAlerts.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-dark">@m.Vehicle?.VehicleName</span>
                                            <div class="small text-muted">@m.Vehicle?.RegistrationNumber</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-warning text-dark">@m.ServiceType</span>
                                        </td>
                                        <td class="small">
                                            @m.ServiceDate.ToString("MMM dd, yyyy")
                                        </td>
                                        <td>
                                            <a asp-controller="Maintenance" asp-action="Details" asp-route-id="@m.MaintenanceId" class="btn btn-sm btn-outline-primary py-0 px-2">
                                                Inspect
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-shield-check fs-1 text-success d-block mb-2"></i>
                        No vehicles currently due for maintenance within the next 7 days.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Trips Activity Table -->
    <div class="col-12 col-lg-6">
        <div class="card card-custom shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history text-primary me-2"></i>Recent Trip Dispatches
                </h6>
                <a asp-controller="Trips" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentTrips != null && Model.RecentTrips.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Route</th>
                                    <th>Vehicle & Driver</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trip in Model.RecentTrips)
                                {
                                    string badgeClass = trip.TripStatus switch
                                    {
                                        "Completed" => "bg-success",
                                        "InProgress" => "bg-primary",
                                        "Scheduled" => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-dark">@trip.Source &rarr; @trip.Destination</span>
                                            <div class="small text-muted">Trip #@trip.TripId</div>
                                        </td>
                                        <td class="small">
                                            <div><i class="bi bi-truck me-1"></i>@(trip.Vehicle?.RegistrationNumber ?? "N/A")</div>
                                            <div><i class="bi bi-person me-1"></i>@(trip.Driver?.FullName ?? "N/A")</div>
                                        </td>
                                        <td>
                                            <span class="badge @badgeClass">@trip.TripStatus</span>
                                        </td>
                                        <td class="small text-muted">
                                            @trip.StartDate.ToString("MMM dd")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-map fs-1 text-secondary d-block mb-2"></i>
                        No trip activity recorded yet.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Reported Vehicle Defects & Issues Feed -->
<div class="card card-custom shadow-sm mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-exclamation-octagon-fill text-danger me-2"></i>Reported Vehicle Defects & Issues
        </h6>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-danger">@Model.OpenVehicleIssuesCount Open</span>
            <a asp-controller="Issues" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Manage All Issues &rarr;</a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentVehicleIssues != null && Model.RecentVehicleIssues.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Vehicle</th>
                            <th>Category</th>
                            <th>Severity</th>
                            <th>Reported By</th>
                            <th>Report Date</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var issue in Model.RecentVehicleIssues)
                        {
                            var severityBadge = issue.Severity switch
                            {
                                VehicleFleetManagement.Models.IssueSeverity.Critical => "bg-danger",
                                VehicleFleetManagement.Models.IssueSeverity.High => "bg-warning text-dark",
                                VehicleFleetManagement.Models.IssueSeverity.Medium => "bg-info text-dark",
                                _ => "bg-secondary"
                            };

                            var statusBadge = issue.Status switch
                            {
                                VehicleFleetManagement.Models.IssueStatus.Open => "bg-danger",
                                VehicleFleetManagement.Models.IssueStatus.UnderReview => "bg-warning text-dark",
                                VehicleFleetManagement.Models.IssueStatus.Resolved => "bg-success",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td>
                                    <span class="fw-bold text-dark">@issue.Vehicle?.VehicleName</span>
                                    <div class="small text-muted font-monospace">@issue.Vehicle?.RegistrationNumber</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@issue.Category</span>
                                    <div class="small text-muted text-truncate" style="max-width: 250px;">@issue.Description</div>
                                </td>
                                <td>
                                    <span class="badge @severityBadge">@issue.Severity</span>
                                </td>
                                <td class="small">
                                    <i class="bi bi-person me-1"></i>@(issue.Driver?.FullName ?? "Fleet Operator")
                                </td>
                                <td class="small text-muted">
                                    @issue.ReportDate.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td>
                                    <span class="badge @statusBadge">@issue.Status</span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Issues" asp-action="Details" asp-route-id="@issue.IssueReportId" class="btn btn-sm btn-outline-primary py-1 px-2">
                                        Inspect
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-shield-check fs-1 text-success d-block mb-2"></i>
                All vehicles report optimal condition. 0 active defect reports in queue.
            </div>
        }
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN for Responsive Visualizations -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            // 1. Vehicle Allocation Doughnut Chart
            var statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VehicleStatusLabels));
            var statusCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VehicleStatusCounts));

            var ctxVehicle = document.getElementById('vehicleStatusChart').getContext('2d');
            new Chart(ctxVehicle, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusCounts,
                        backgroundColor: ['#10B981', '#F59E0B', '#EF4444'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });

            // 2. Monthly Expense Trends Grouped Bar Chart
            var expenseMonths = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseMonths));
            var monthlyFuel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyFuelData));
            var monthlyMaint = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyMaintenanceData));

            var ctxExpense = document.getElementById('monthlyExpenseChart').getContext('2d');
            new Chart(ctxExpense, {
                type: 'bar',
                data: {
                    labels: expenseMonths,
                    datasets: [
                        {
                            label: 'Fuel Procurement ($)',
                            data: monthlyFuel,
                            backgroundColor: 'rgba(59, 130, 246, 0.8)',
                            borderColor: '#3B82F6',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'Maintenance Servicing ($)',
                            data: monthlyMaint,
                            backgroundColor: 'rgba(234, 88, 12, 0.8)',
                            borderColor: '#EA580C',
                            borderWidth: 1,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) {
                                    return '$' + value.toLocaleString();
                                }
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top'
                        }
                    }
                }
            });
        });
    </script>
}
