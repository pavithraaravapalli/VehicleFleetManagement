@{
    ViewData["Title"] = "Driver Profile Unlinked";
}

<div class="row justify-content-center align-items-center" style="min-height: 50vh;">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card card-custom p-5 shadow-sm">
            <div class="mb-3 text-warning">
                <i class="bi bi-exclamation-octagon display-2"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Driver Profile Not Linked</h3>
            <p class="text-muted mb-4">
                @(ViewBag.ErrorMessage ?? "Your user account is assigned the Driver role, but has not yet been linked to an operational Driver profile with license credentials.")
            </p>
            <p class="small text-secondary mb-4">
                Please contact the system administrator to link your license and contact details in the Driver Directory.
            </p>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                </button>
            </form>
        </div>
    </div>
</div>
