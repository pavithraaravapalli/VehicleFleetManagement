@model VehicleFleetManagement.ViewModels.CompleteTripViewModel
@{
    ViewData["Title"] = $"Complete Trip #{Model.TripId} - FleetFlow Pro";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-modern p-4 p-md-5 shadow-sm border-0 rounded-4">
            <div class="text-center mb-4">
                <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success rounded-circle p-3 d-inline-flex mb-2 fs-2">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Complete Journey #@Model.TripId</h3>
                <p class="text-muted small mb-0">Record final odometer reading and journey remarks to release vehicle and driver</p>
            </div>

            <!-- Route and Start Odometer Summary -->
            <div class="bg-light p-3 rounded-3 mb-4 border">
                <div class="row g-2 small">
                    <div class="col-sm-4 text-muted fw-semibold">Route:</div>
                    <div class="col-sm-8 fw-bold text-dark">@Model.Route</div>

                    <div class="col-sm-4 text-muted fw-semibold">Vehicle:</div>
                    <div class="col-sm-8 fw-bold text-primary">@Model.VehicleName (@Model.RegistrationNumber)</div>

                    <div class="col-sm-4 text-muted fw-semibold">Starting Odometer:</div>
                    <div class="col-sm-8 fw-bold text-secondary font-monospace" id="startOdoDisplay">@Model.StartOdometer.ToString("N2") km</div>
                </div>
            </div>

            <form asp-action="Complete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TripId" />
                <input type="hidden" asp-for="VehicleName" />
                <input type="hidden" asp-for="RegistrationNumber" />
                <input type="hidden" asp-for="DriverName" />
                <input type="hidden" asp-for="Route" />
                <input type="hidden" asp-for="StartOdometer" id="startOdoInput" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="EndOdometer" class="form-label fw-semibold small text-dark"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-speedometer2"></i></span>
                        <input asp-for="EndOdometer" type="number" step="0.01" class="form-control border-start-0 border-end-0" id="endOdoInput" autofocus required />
                        <span class="input-group-text bg-light text-muted">km</span>
                    </div>
                    <span asp-validation-for="EndOdometer" class="text-danger small"></span>
                    <div class="form-text small text-muted">
                        Must be greater than or equal to start reading (@Model.StartOdometer.ToString("N0") km).
                    </div>
                </div>

                <!-- Live Dynamic Distance Calculation Preview -->
                <div class="alert alert-info py-2 px-3 small d-flex justify-content-between align-items-center mb-3 rounded-3">
                    <span><i class="bi bi-speedometer2 me-1"></i> Distance Travelled:</span>
                    <strong class="fs-6 text-primary" id="calculatedDistance">0.00 km</strong>
                </div>

                <div class="mb-3">
                    <label asp-for="ActualEndDate" class="form-label fw-semibold small text-dark"></label>
                    <input asp-for="ActualEndDate" type="datetime-local" class="form-control" value="@Model.ActualEndDate.ToString("yyyy-MM-ddTHH:mm")" required />
                    <span asp-validation-for="ActualEndDate" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="TripNotes" class="form-label fw-semibold small text-dark"></label>
                    <textarea asp-for="TripNotes" class="form-control" rows="3" placeholder="Optional notes: weather conditions, traffic delays, vehicle performance remarks"></textarea>
                    <span asp-validation-for="TripNotes" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="@(User.IsInRole("Driver") ? "MyTrips" : "Index")" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Finalize Trip & Release Vehicle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            const startOdo = parseFloat($('#startOdoInput').val()) || 0;
            
            function updateDistance() {
                const endOdo = parseFloat($('#endOdoInput').val()) || 0;
                const distance = endOdo >= startOdo ? (endOdo - startOdo).toFixed(2) : '0.00';
                $('#calculatedDistance').text(distance + ' km');
            }

            $('#endOdoInput').on('input change', updateDistance);
            updateDistance();
        });
    </script>
}
