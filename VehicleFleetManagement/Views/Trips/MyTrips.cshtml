@model IEnumerable<VehicleFleetManagement.Models.Trip>
@{
    ViewData["Title"] = "My Assigned Journeys";
    var driver = ViewBag.Driver as VehicleFleetManagement.Models.Driver;
    string selectedStatus = ViewBag.SelectedStatus as string ?? "";
}

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card card-custom p-4 shadow-sm border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white rounded-circle p-3 me-3 fs-3">
                        <i class="bi bi-steering-wheel"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1" style="color: #172554;">Driver Dispatch Portal</h3>
                        <div class="text-muted small">
                            Operating Driver: <strong>@(driver?.FullName ?? User.Identity?.Name)</strong> | 
                            License: <span class="badge bg-light text-dark border font-monospace">@(driver?.LicenseNumber ?? "N/A")</span> |
                            Status: <span class="badge bg-success">@(driver?.AvailabilityStatus ?? "Available")</span>
                        </div>
                    </div>
                </div>
                <div class="mt-3 mt-md-0">
                    <a asp-controller="Fuel" asp-action="Create" class="btn btn-outline-primary">
                        <i class="bi bi-fuel-pump me-1"></i> Log Fuel Purchase
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Filter Tabs -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="btn-group btn-group-sm">
        <a asp-action="MyTrips" class="btn @(string.IsNullOrEmpty(selectedStatus) ? "btn-primary" : "btn-outline-secondary")">All Journeys</a>
        <a asp-action="MyTrips" asp-route-status="Scheduled" class="btn @(selectedStatus == "Scheduled" ? "btn-primary" : "btn-outline-secondary")">Scheduled</a>
        <a asp-action="MyTrips" asp-route-status="InProgress" class="btn @(selectedStatus == "InProgress" ? "btn-primary" : "btn-outline-secondary")">In Progress</a>
        <a asp-action="MyTrips" asp-route-status="Completed" class="btn @(selectedStatus == "Completed" ? "btn-primary" : "btn-outline-secondary")">Completed</a>
    </div>
    <div class="text-muted small">
        Showing <strong>@(Model?.Count() ?? 0)</strong> journey(s)
    </div>
</div>

<!-- Trips Cards Grid -->
<div class="row g-3">
    @if (Model != null && Model.Any())
    {
        foreach (var trip in Model)
        {
            <div class="col-12 col-lg-6">
                <div class="card card-custom h-100 shadow-sm p-3 border-top @(trip.TripStatus == "InProgress" ? "border-primary border-4" : trip.TripStatus == "Completed" ? "border-success border-3" : "border-info border-3")">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-light text-secondary border me-1">Trip #@trip.TripId</span>
                            @if (trip.TripStatus == "Scheduled")
                            {
                                <span class="badge bg-info text-dark"><i class="bi bi-calendar-event me-1"></i> Scheduled</span>
                            }
                            else if (trip.TripStatus == "InProgress")
                            {
                                <span class="badge bg-primary"><i class="bi bi-play-circle me-1"></i> Active / In Progress</span>
                            }
                            else if (trip.TripStatus == "Completed")
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@trip.TripStatus</span>
                            }
                        </div>
                        <div class="text-muted small">
                            <i class="bi bi-clock me-1"></i> @trip.StartDate.ToString("g")
                        </div>
                    </div>

                    <!-- Route Display -->
                    <div class="p-3 bg-light rounded mb-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-geo-alt-fill text-success me-2"></i>
                            <div class="fw-bold text-dark">@trip.Source</div>
                            <i class="bi bi-arrow-right mx-2 text-muted"></i>
                            <i class="bi bi-flag-fill text-danger me-2"></i>
                            <div class="fw-bold text-dark">@trip.Destination</div>
                        </div>
                        <div class="text-muted small mt-1 text-truncate">
                            <i class="bi bi-chat-left-text me-1"></i> @trip.Purpose
                        </div>
                    </div>

                    <!-- Vehicle & Odometer Info -->
                    <div class="row g-2 small mb-3">
                        <div class="col-6">
                            <div class="text-muted">Assigned Vehicle:</div>
                            <div class="fw-semibold">@(trip.Vehicle?.VehicleName ?? "N/A")</div>
                            <span class="badge bg-light text-dark border font-monospace">@trip.Vehicle?.RegistrationNumber</span>
                        </div>
                        <div class="col-6">
                            <div class="text-muted">Distance Covered:</div>
                            @if (trip.TripStatus == "Completed")
                            {
                                <div class="fw-bold text-success fs-6">@trip.Distance.ToString("N1") km</div>
                            }
                            else
                            {
                                <div class="text-muted">Start Odo: @trip.StartOdometer.ToString("N0") km</div>
                            }
                        </div>
                    </div>

                    <!-- Actions Toolbar for Driver -->
                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <a asp-action="Details" asp-route-id="@trip.TripId" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-info-circle me-1"></i> Details
                        </a>

                        <div class="d-flex gap-2">
                            @if (trip.TripStatus == "Scheduled")
                            {
                                <a asp-action="Start" asp-route-id="@trip.TripId" class="btn btn-sm btn-primary">
                                    <i class="bi bi-play-fill me-1"></i> Start Journey
                                </a>
                            }
                            else if (trip.TripStatus == "InProgress")
                            {
                                <a asp-controller="Fuel" asp-action="Create" asp-route-tripId="@trip.TripId" asp-route-vehicleId="@trip.VehicleId" class="btn btn-sm btn-outline-warning text-dark">
                                    <i class="bi bi-fuel-pump me-1"></i> Log Fuel
                                </a>
                                <a asp-action="Complete" asp-route-id="@trip.TripId" class="btn btn-sm btn-success">
                                    <i class="bi bi-check2-circle me-1"></i> Finish & Log End Odometer
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card card-custom p-5 text-center shadow-sm">
                <i class="bi bi-inbox display-3 text-secondary mb-3"></i>
                <h4 class="fw-bold text-dark">No Assigned Journeys</h4>
                <p class="text-muted">You have no journeys matching the selected status filter. New trip dispatches will appear here automatically.</p>
            </div>
        </div>
    }
</div>
