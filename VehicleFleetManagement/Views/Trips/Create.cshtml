@model VehicleFleetManagement.ViewModels.CreateTripViewModel
@{
    ViewData["Title"] = "Schedule New Trip";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        <div class="card card-custom p-4 shadow-sm mb-4">
            <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                <div class="bg-primary text-white rounded-circle p-3 me-3 fs-3">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold" style="color: #172554;">Schedule & Dispatch Trip</h3>
                    <div class="text-muted small">Select an available vehicle and certified driver to allocate for an operational route</div>
                </div>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <!-- Vehicle Selection -->
                    <div class="col-md-6">
                        <label asp-for="VehicleId" class="form-label fw-semibold small"></label>
                        <select asp-for="VehicleId" asp-items="Model.AvailableVehicles" class="form-select">
                            <option value="">-- Select Available Vehicle --</option>
                        </select>
                        <span asp-validation-for="VehicleId" class="text-danger small"></span>
                    </div>

                    <!-- Driver Selection -->
                    <div class="col-md-6">
                        <label asp-for="DriverId" class="form-label fw-semibold small"></label>
                        <select asp-for="DriverId" asp-items="Model.AvailableDrivers" class="form-select">
                            <option value="">-- Select Available Driver --</option>
                        </select>
                        <span asp-validation-for="DriverId" class="text-danger small"></span>
                    </div>

                    <!-- Origin & Destination -->
                    <div class="col-md-6">
                        <label asp-for="Source" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-success"><i class="bi bi-geo-alt"></i></span>
                            <input asp-for="Source" class="form-control" placeholder="e.g. Central Warehouse, New York" />
                        </div>
                        <span asp-validation-for="Source" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Destination" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-danger"><i class="bi bi-flag"></i></span>
                            <input asp-for="Destination" class="form-control" placeholder="e.g. Distribution Hub, Philadelphia" />
                        </div>
                        <span asp-validation-for="Destination" class="text-danger small"></span>
                    </div>

                    <!-- Dates -->
                    <div class="col-md-4">
                        <label asp-for="StartDate" class="form-label fw-semibold small"></label>
                        <input asp-for="StartDate" type="datetime-local" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ExpectedEndDate" class="form-label fw-semibold small"></label>
                        <input asp-for="ExpectedEndDate" type="datetime-local" class="form-control" value="@Model.ExpectedEndDate.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="ExpectedEndDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StartOdometer" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <input asp-for="StartOdometer" type="number" step="0.01" class="form-control" placeholder="Auto-synced with vehicle" />
                            <span class="input-group-text bg-light text-muted">km</span>
                        </div>
                        <span asp-validation-for="StartOdometer" class="text-danger small"></span>
                    </div>

                    <!-- Purpose -->
                    <div class="col-md-12">
                        <label asp-for="Purpose" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Purpose" rows="3" class="form-control" placeholder="Describe journey objectives, cargo, or official passenger mission..."></textarea>
                        <span asp-validation-for="Purpose" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-send-check me-1"></i> Dispatch & Schedule Trip
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
