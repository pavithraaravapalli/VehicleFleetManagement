@model IEnumerable<VehicleFleetManagement.Models.Trip>
@{
    ViewData["Title"] = "Fleet Trips & Dispatch";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    string searchTerm = ViewBag.SearchTerm as string ?? "";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "";
    string fromDate = ViewBag.FromDate as string ?? "";
    string toDate = ViewBag.ToDate as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: #172554;">Fleet Trips & Operations</h2>
        <p class="text-muted small mb-0">Total of <strong>@totalCount</strong> operational journeys logged across the system</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn text-white shadow-sm" style="background-color: #172554;">
            <i class="bi bi-geo-alt-fill me-1"></i> Schedule New Trip
        </a>
    }
</div>

<!-- Search & Filtering Card -->
<div class="card card-custom p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-12 col-md-3">
            <label class="form-label small fw-semibold text-muted">Search Route / Vehicle / Driver</label>
            <div class="input-group">
                <span class="input-group-text bg-light text-secondary border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" value="@searchTerm" class="form-control border-start-0" placeholder="Origin, Dest, Reg#, Name..." />
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-2">
            <label class="form-label small fw-semibold text-muted">Trip Status</label>
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <!option value="Scheduled" @(selectedStatus == "Scheduled" ? "selected" : "")>Scheduled</!option>
                <!option value="InProgress" @(selectedStatus == "InProgress" ? "selected" : "")>In Progress</!option>
                <!option value="Completed" @(selectedStatus == "Completed" ? "selected" : "")>Completed</!option>
                <!option value="Cancelled" @(selectedStatus == "Cancelled" ? "selected" : "")>Cancelled</!option>
            </select>
        </div>
        <div class="col-12 col-sm-6 col-md-2">
            <label class="form-label small fw-semibold text-muted">Departure From</label>
            <input type="date" name="fromDate" value="@fromDate" class="form-control" />
        </div>
        <div class="col-12 col-sm-6 col-md-2">
            <label class="form-label small fw-semibold text-muted">Departure To</label>
            <input type="date" name="toDate" value="@toDate" class="form-control" />
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel me-1"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Trips Table -->
<div class="card card-custom shadow-sm mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Trip #</th>
                        <th>Route</th>
                        <th>Vehicle</th>
                        <th>Driver</th>
                        <th>Departure</th>
                        <th>Distance</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var t in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@t.TripId" class="fw-bold text-decoration-none text-primary">
                                        #@t.TripId
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@t.Source</div>
                                    <div class="text-muted small"><i class="bi bi-arrow-down-short text-primary"></i> @t.Destination</div>
                                </td>
                                <td>
                                    <div>@(t.Vehicle?.VehicleName ?? "N/A")</div>
                                    <span class="badge bg-light text-secondary border font-monospace">@t.Vehicle?.RegistrationNumber</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@(t.Driver?.FullName ?? "N/A")</div>
                                    <div class="text-muted small">@t.Driver?.PhoneNumber</div>
                                </td>
                                <td>
                                    <div>@t.StartDate.ToString("g")</div>
                                    <div class="text-muted small">Exp: @t.ExpectedEndDate.ToString("g")</div>
                                </td>
                                <td>
                                    @if (t.TripStatus == "Completed")
                                    {
                                        <span class="fw-bold text-success">@t.Distance.ToString("N1") km</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>
                                <td>
                                    @if (t.TripStatus == "Scheduled")
                                    {
                                        <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-calendar-check me-1"></i> Scheduled</span>
                                    }
                                    else if (t.TripStatus == "InProgress")
                                    {
                                        <span class="badge bg-primary px-2 py-1"><i class="bi bi-geo-alt me-1"></i> In Progress</span>
                                    }
                                    else if (t.TripStatus == "Completed")
                                    {
                                        <span class="badge bg-success px-2 py-1"><i class="bi bi-check2-circle me-1"></i> Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">@t.TripStatus</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@t.TripId" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (t.TripStatus == "Scheduled")
                                        {
                                            <a asp-action="Start" asp-route-id="@t.TripId" class="btn btn-outline-primary" title="Start Trip">
                                                <i class="bi bi-play-fill"></i> Start
                                            </a>
                                        }
                                        else if (t.TripStatus == "InProgress")
                                        {
                                            <a asp-action="Complete" asp-route-id="@t.TripId" class="btn btn-outline-success" title="Complete Trip">
                                                <i class="bi bi-check-lg"></i> Complete
                                            </a>
                                        }

                                        @if (User.IsInRole("Admin") && t.TripStatus != "Completed" && t.TripStatus != "Cancelled")
                                        {
                                            <form asp-action="Cancel" asp-route-id="@t.TripId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this trip?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Cancel Trip">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-signpost-split display-4 d-block mb-2 text-secondary"></i>
                                No trips found matching the specified filter criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav aria-label="Trip Page Navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-page="@(currentPage - 1)" 
                   asp-route-searchTerm="@searchTerm" 
                   asp-route-status="@selectedStatus" 
                   asp-route-fromDate="@fromDate" 
                   asp-route-toDate="@toDate">
                    &laquo; Previous
                </a>
            </li>

            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@p" 
                       asp-route-searchTerm="@searchTerm" 
                       asp-route-status="@selectedStatus" 
                       asp-route-fromDate="@fromDate" 
                       asp-route-toDate="@toDate">
                        @p
                    </a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-page="@(currentPage + 1)" 
                   asp-route-searchTerm="@searchTerm" 
                   asp-route-status="@selectedStatus" 
                   asp-route-fromDate="@fromDate" 
                   asp-route-toDate="@toDate">
                    Next &raquo;
                </a>
            </li>
        </ul>
    </nav>
}
