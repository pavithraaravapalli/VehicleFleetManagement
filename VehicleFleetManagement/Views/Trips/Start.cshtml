@model VehicleFleetManagement.ViewModels.StartTripViewModel
@{
    ViewData["Title"] = $"Start Trip #{Model.TripId}";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-custom p-4 shadow-sm border-primary border-top border-4">
            <div class="text-center mb-4">
                <div class="bg-primary text-white rounded-circle p-3 d-inline-flex mb-2 fs-2">
                    <i class="bi bi-play-circle-fill"></i>
                </div>
                <h3 class="fw-bold text-dark">Commence Operational Journey</h3>
                <p class="text-muted small">Verify initial odometer reading to start Trip #@Model.TripId</p>
            </div>

            <!-- Route and Vehicle Summary -->
            <div class="bg-light p-3 rounded mb-4">
                <div class="row g-2 small">
                    <div class="col-sm-4 text-muted fw-semibold">Route:</div>
                    <div class="col-sm-8 fw-bold text-dark">@Model.Route</div>

                    <div class="col-sm-4 text-muted fw-semibold">Vehicle:</div>
                    <div class="col-sm-8 fw-bold text-primary">@Model.VehicleName (@Model.RegistrationNumber)</div>

                    <div class="col-sm-4 text-muted fw-semibold">Operating Driver:</div>
                    <div class="col-sm-8">@Model.DriverName</div>
                </div>
            </div>

            <form asp-action="Start" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TripId" />
                <input type="hidden" asp-for="VehicleName" />
                <input type="hidden" asp-for="RegistrationNumber" />
                <input type="hidden" asp-for="DriverName" />
                <input type="hidden" asp-for="Route" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="StartOdometer" class="form-label fw-semibold small"></label>
                    <div class="input-group">
                        <input asp-for="StartOdometer" type="number" step="0.01" class="form-control" autofocus />
                        <span class="input-group-text bg-light text-muted">km</span>
                    </div>
                    <span asp-validation-for="StartOdometer" class="text-danger small"></span>
                    <div class="form-text small text-muted">
                        Inspect the vehicle dashboard odometer before departing and verify accurate kilometer reading.
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="@(User.IsInRole("Driver") ? "MyTrips" : "Index")" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-play-fill me-1"></i> Confirm & Start Journey
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
