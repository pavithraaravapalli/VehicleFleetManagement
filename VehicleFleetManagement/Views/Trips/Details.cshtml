@model VehicleFleetManagement.Models.Trip
@{
    ViewData["Title"] = $"Journey #{Model.TripId} Details - FleetFlow Pro";
    bool isAdmin = User.IsInRole("Admin");
    bool isDriver = User.IsInRole("Driver");
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0 text-dark">Journey #@Model.TripId</h2>
            @if (Model.TripStatus == "Scheduled")
            {
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 fs-6 rounded-pill">Scheduled</span>
            }
            else if (Model.TripStatus == "InProgress")
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6 rounded-pill">In Progress</span>
            }
            else if (Model.TripStatus == "Completed")
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 rounded-pill">Completed</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary px-3 py-2 fs-6 rounded-pill">@Model.TripStatus</span>
            }
        </div>
        <p class="text-muted small mb-0 mt-1">Operational Dispatch Record, Odometer Audit & Review Telemetry</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.TripStatus == "Scheduled" && (isDriver || isAdmin))
        {
            <a asp-action="Start" asp-route-id="@Model.TripId" class="btn btn-primary rounded-pill px-3">
                <i class="bi bi-play-fill me-1"></i> Start Trip
            </a>
        }
        else if (Model.TripStatus == "InProgress" && (isDriver || isAdmin))
        {
            <a asp-action="Complete" asp-route-id="@Model.TripId" class="btn btn-success rounded-pill px-3">
                <i class="bi bi-check-lg me-1"></i> Conclude Trip
            </a>
            <a asp-controller="Issues" asp-action="Create" asp-route-vehicleId="@Model.VehicleId" asp-route-tripId="@Model.TripId" class="btn btn-outline-danger rounded-pill px-3">
                <i class="bi bi-exclamation-triangle me-1"></i> Report Fault
            </a>
        }
        else if (Model.TripStatus == "Completed" && !isDriver)
        {
            <button type="button" class="btn btn-warning rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#reviewModal">
                <i class="bi bi-star-fill me-1"></i> Review Driver
            </button>
        }

        <a asp-action="@(isDriver ? "MyTrips" : (isAdmin ? "Index" : "UserTrips"))" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Trips
        </a>
    </div>
</div>

<!-- Metrics Row -->
<div class="row g-3 mb-4">
    @if (isAdmin || isDriver)
    {
        <div class="col-12 col-md-3">
            <div class="card card-stat">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold d-block text-uppercase">Total Distance</span>
                        <h3 class="fw-bold mb-0 text-success">
                            @(Model.TripStatus == "Completed" ? $"{Model.Distance:N1} km" : "In Flight")
                        </h3>
                    </div>
                    <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                </div>
                <small class="text-muted mt-1 d-block">Audited odometer variance</small>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card card-stat">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold d-block text-uppercase">Start Odometer</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.StartOdometer.ToString("N0") <span class="fs-6 text-muted">km</span></h3>
                    </div>
                    <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-play-circle"></i>
                    </div>
                </div>
                <small class="text-muted mt-1 d-block">Dispatch departure reading</small>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card card-stat">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold d-block text-uppercase">End Odometer</span>
                        <h3 class="fw-bold mb-0 text-dark">
                            @(Model.EndOdometer.HasValue ? $"{Model.EndOdometer.Value:N0} km" : "Pending")
                        </h3>
                    </div>
                    <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info">
                        <i class="bi bi-flag"></i>
                    </div>
                </div>
                <small class="text-muted mt-1 d-block">Arrival log reading</small>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card card-stat">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold d-block text-uppercase">Departure Date</span>
                        <h4 class="fw-bold mb-0 text-dark">@Model.StartDate.ToString("MMM dd, yyyy")</h4>
                    </div>
                    <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                </div>
                <small class="text-muted mt-1 d-block">@Model.StartDate.ToString("HH:mm")</small>
            </div>
        </div>
    }
    else
    {
        <div class="col-12 col-md-3">
            <div class="card card-stat">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold d-block text-uppercase">Journey Status</span>
                        <h4 class="fw-bold mb-0 text-primary">@Model.TripStatus</h4>
                    </div>
                    <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
                <small class="text-muted mt-1 d-block">Current operational state</small>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card card-stat">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold d-block text-uppercase">Journey Distance</span>
                        <h4 class="fw-bold mb-0 text-success">
                            @(Model.Distance > 0 ? $"{Model.Distance:N1} km" : "Pending completion")
                        </h4>
                    </div>
                    <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
                        <i class="bi bi-signpost-split"></i>
                    </div>
                </div>
                <small class="text-muted mt-1 d-block">Covered route distance</small>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card card-stat">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold d-block text-uppercase">Departure</span>
                        <h5 class="fw-bold mb-0 text-dark">@Model.StartDate.ToString("MMM dd, yyyy")</h5>
                    </div>
                    <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                </div>
                <small class="text-muted mt-1 d-block">Scheduled: @Model.StartDate.ToString("HH:mm")</small>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card card-stat">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold d-block text-uppercase">Assigned Vehicle</span>
                        <h5 class="fw-bold mb-0 text-dark text-truncate">@(Model.Vehicle?.RegistrationNumber ?? "Assigned")</h5>
                    </div>
                    <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info">
                        <i class="bi bi-truck"></i>
                    </div>
                </div>
                <small class="text-muted mt-1 d-block">@(Model.Vehicle?.VehicleName ?? "Fleet Transport")</small>
            </div>
        </div>
    }
</div>

<div class="row g-4 mb-4">
    <!-- Route & Timeline Card -->
    <div class="col-12 col-lg-6">
        <div class="card card-modern h-100 shadow-sm p-4 border-0">
            <h5 class="fw-bold mb-3 text-dark">
                <i class="bi bi-pin-map-fill me-2 text-primary"></i> Route & Journey Timeline
            </h5>
            <div class="d-flex align-items-center mb-3 p-3 bg-light rounded-3">
                <div class="me-3 text-center">
                    <i class="bi bi-geo-alt-fill text-success fs-3"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="small text-muted">Departure Origin</div>
                    <div class="fw-bold text-dark fs-6">@Model.Source</div>
                </div>
                <div class="mx-3 text-muted">
                    <i class="bi bi-arrow-right fs-4"></i>
                </div>
                <div class="text-center me-3">
                    <i class="bi bi-flag-fill text-danger fs-3"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="small text-muted">Final Destination</div>
                    <div class="fw-bold text-dark fs-6">@Model.Destination</div>
                </div>
            </div>

            <div class="row g-2 small mb-3">
                <div class="col-sm-5 text-muted fw-semibold">Scheduled Departure:</div>
                <div class="col-sm-7 fw-bold">@Model.StartDate.ToString("f")</div>

                <div class="col-sm-5 text-muted fw-semibold">Expected Arrival:</div>
                <div class="col-sm-7">@Model.ExpectedEndDate.ToString("f")</div>

                @if (Model.ActualStartDate.HasValue)
                {
                    <div class="col-sm-5 text-muted fw-semibold">Actual Departure:</div>
                    <div class="col-sm-7 text-primary fw-semibold">@Model.ActualStartDate.Value.ToString("f")</div>
                }

                <div class="col-sm-5 text-muted fw-semibold">Actual Arrival:</div>
                <div class="col-sm-7 fw-bold text-success">
                    @(Model.ActualEndDate.HasValue ? Model.ActualEndDate.Value.ToString("f") : "In Progress / Not Complete")
                </div>
            </div>

            <div class="border-top pt-3">
                <div class="small text-muted fw-semibold">Trip Purpose:</div>
                <div class="text-dark">@Model.Purpose</div>
            </div>

            @if (!string.IsNullOrEmpty(Model.TripNotes))
            {
                <div class="border-top pt-3 mt-3">
                    <div class="small text-muted fw-semibold"><i class="bi bi-journal-text text-primary me-1"></i> Driver Remarks & Notes:</div>
                    <div class="p-2 bg-light rounded text-dark small mt-1">"@Model.TripNotes"</div>
                </div>
            }
        </div>
    </div>

    <!-- Assigned Resources (Vehicle & Driver) Card -->
    <div class="col-12 col-lg-6">
        <div class="card card-modern h-100 shadow-sm p-4 border-0">
            <h5 class="fw-bold mb-3 text-dark">
                <i class="bi bi-person-badge-fill me-2 text-primary"></i> Assigned Resources
            </h5>

            <!-- Vehicle Summary -->
            <div class="d-flex align-items-center p-3 mb-3 border rounded-3 bg-light">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-3">
                    <i class="bi bi-truck fs-3"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold text-dark">@(Model.Vehicle?.VehicleName ?? "N/A")</div>
                    <div class="text-muted small">@Model.Vehicle?.Model &bull; @Model.Vehicle?.FuelType</div>
                    <span class="badge bg-secondary font-monospace">@Model.Vehicle?.RegistrationNumber</span>
                </div>
                @if (isAdmin && Model.VehicleId > 0)
                {
                    <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@Model.VehicleId" class="btn btn-sm btn-outline-secondary rounded-pill">
                        View Vehicle
                    </a>
                }
            </div>

            <!-- Driver Summary -->
            <div class="d-flex align-items-center p-3 border rounded-3 bg-light">
                @if (!string.IsNullOrEmpty(Model.Driver?.ProfilePictureUrl))
                {
                    <img src="@Model.Driver.ProfilePictureUrl" alt="@Model.Driver.FullName" class="avatar-circle me-3" />
                }
                else
                {
                    <div class="avatar-placeholder me-3" style="width: 44px; height: 44px;">
                        @((Model.Driver?.FullName?.Length > 0 ? Model.Driver.FullName[0].ToString().ToUpper() : "D"))
                    </div>
                }
                <div class="flex-grow-1">
                    <div class="fw-bold text-dark">@(Model.Driver?.FullName ?? "N/A")</div>
                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i> @Model.Driver?.PhoneNumber</div>
                    <span class="badge bg-light text-dark border">License: @Model.Driver?.LicenseNumber</span>
                    <span class="text-warning small ms-2"><i class="bi bi-star-fill"></i> @(Model.Driver?.Rating.ToString("N1") ?? "5.0")</span>
                </div>
                @if (Model.DriverId > 0)
                {
                    <a asp-controller="Drivers" asp-action="Profile" asp-route-id="@Model.DriverId" class="btn btn-sm btn-outline-primary rounded-pill">
                        Driver Profile
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@if (isDriver || isAdmin)
{
    <!-- Linked Fuel Purchases -->
    <div class="card card-modern shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-fuel-pump-fill me-2 text-primary"></i> Fuel Purchases Logged For This Journey (@(Model.FuelLogs?.Count ?? 0))
            </h5>
            @if (Model.TripStatus == "InProgress" || Model.TripStatus == "Completed")
            {
                <a asp-controller="Fuel" asp-action="Create" asp-route-tripId="@Model.TripId" asp-route-vehicleId="@Model.VehicleId" class="btn btn-sm btn-outline-primary rounded-pill">
                    <i class="bi bi-plus-circle me-1"></i> Log Fuel For This Trip
                </a>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-4">Date</th>
                            <th>Station</th>
                            <th>Quantity (Litres)</th>
                            <th>Price Per Litre</th>
                            <th>Total Cost</th>
                            <th>Odometer at Refill</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FuelLogs != null && Model.FuelLogs.Any())
                        {
                            foreach (var f in Model.FuelLogs)
                            {
                                <tr>
                                    <td class="ps-4">@f.FuelDate.ToString("d")</td>
                                    <td>@f.FuelStation</td>
                                    <td>@f.FuelQuantity.ToString("N2") L</td>
                                    <td>$@f.PricePerLitre.ToString("N2")</td>
                                    <td class="fw-bold text-success">$@f.TotalCost.ToString("N2")</td>
                                    <td>@f.OdometerReading.ToString("N0") km</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted small">
                                    No fuel refills recorded specifically for this trip.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Review Driver Modal (Visible for passengers / staff on completed trips) -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold text-dark" id="reviewModalLabel">
                    <i class="bi bi-star-fill text-warning me-2"></i> Review Driver: @Model.Driver?.FullName
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Drivers" asp-action="SubmitReview" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="driverId" value="@Model.DriverId" />
                <input type="hidden" name="tripId" value="@Model.TripId" />

                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Share your feedback regarding driver punctuality, vehicle comfort, and driving safety on Journey #@Model.TripId.
                    </p>

                    <div class="mb-3 text-center">
                        <label class="form-label small fw-semibold text-dark d-block">Overall Star Rating</label>
                        <div class="star-rating-interactive my-2" id="starContainer">
                            <i class="bi bi-star-fill active text-warning" data-value="1"></i>
                            <i class="bi bi-star-fill active text-warning" data-value="2"></i>
                            <i class="bi bi-star-fill active text-warning" data-value="3"></i>
                            <i class="bi bi-star-fill active text-warning" data-value="4"></i>
                            <i class="bi bi-star-fill active text-warning" data-value="5"></i>
                        </div>
                        <input type="hidden" name="rating" id="ratingInput" value="5" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Review Comments</label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Excellent navigation, smooth driving, and on-time arrival!" maxlength="500" required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4">Submit Review</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const stars = document.querySelectorAll('#starContainer i');
            const ratingInput = document.getElementById('ratingInput');

            stars.forEach(star => {
                star.addEventListener('click', function () {
                    const val = parseInt(this.getAttribute('data-value'));
                    ratingInput.value = val;
                    stars.forEach((s, idx) => {
                        if (idx < val) {
                            s.className = 'bi bi-star-fill active text-warning';
                        } else {
                            s.className = 'bi bi-star text-muted';
                        }
                    });
                });
            });
        });
    </script>
}
