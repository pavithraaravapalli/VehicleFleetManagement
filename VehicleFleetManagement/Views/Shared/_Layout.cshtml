<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? ViewData["Title"] ?? "Portal") - FleetFlow Pro</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom FleetFlow Pro SaaS Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-fleet py-2 sticky-top">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Dashboard" asp-action="Index">
                    <div class="stat-icon-wrapper bg-teal text-white rounded-3 p-1 me-2" style="background-color: var(--fleet-teal); width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-truck-front-fill fs-5"></i>
                    </div>
                    <span>FleetFlow <span class="brand-badge">PRO</span></span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#fleetNavContent" aria-controls="fleetNavContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="fleetNavContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Dashboard" asp-action="Admin">
                                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Vehicles" asp-action="Index">
                                        <i class="bi bi-truck me-1"></i> Vehicles
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Drivers" asp-action="Index">
                                        <i class="bi bi-person-badge me-1"></i> Drivers
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Trips" asp-action="Index">
                                        <i class="bi bi-signpost-2 me-1"></i> Trips
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Maintenance" asp-action="Index">
                                        <i class="bi bi-tools me-1"></i> Maintenance
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Fuel" asp-action="Index">
                                        <i class="bi bi-fuel-pump me-1"></i> Fuel
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Issues" asp-action="Index">
                                        <i class="bi bi-exclamation-triangle me-1"></i> Faults
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reports" asp-action="Index">
                                        <i class="bi bi-graph-up-arrow me-1"></i> Reports
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Driver"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Dashboard" asp-action="Driver">
                                        <i class="bi bi-speedometer2 me-1"></i> My Workspace
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Trips" asp-action="MyTrips">
                                        <i class="bi bi-geo-alt me-1"></i> My Trips
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Issues" asp-action="Create">
                                        <i class="bi bi-exclamation-circle me-1"></i> Report Fault
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Fuel" asp-action="Create">
                                        <i class="bi bi-fuel-pump me-1"></i> Log Refill
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Drivers" asp-action="Profile">
                                        <i class="bi bi-person-vcard me-1"></i> Profile & Ratings
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="User">
                                        <i class="bi bi-speedometer2 me-1"></i> Workspace
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Trips" ? "active" : "")" asp-controller="Trips" asp-action="Index">
                                        <i class="bi bi-signpost-2 me-1"></i> Trip Schedules
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "active" : "")" asp-controller="Notifications" asp-action="Index">
                                        <i class="bi bi-bell me-1"></i> Notifications
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-gear me-1"></i> My Profile
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Floating Toast Container -->
    <div class="toast-container" id="toastPlacement">
        @if (TempData["Success"] != null)
        {
            <div class="toast align-items-center text-bg-success border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="6000">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center">
                        <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                        <span>@TempData["Success"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast align-items-center text-bg-danger border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="8000">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="toast align-items-center text-bg-primary border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="6000">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center">
                        <i class="bi bi-info-circle-fill fs-5 me-2"></i>
                        <span>@TempData["Info"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <div class="container-fluid px-3 px-lg-4 py-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-fleet py-3">
        <div class="container-fluid px-3 px-lg-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                &copy; 2026 - <strong>FleetFlow Pro</strong> Commercial SaaS Fleet Operations
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-secondary border"><i class="bi bi-hdd-network me-1"></i> ASP.NET Core 10 MVC</span>
                <span class="badge bg-light text-secondary border"><i class="bi bi-database me-1"></i> SQL Server LocalDB</span>
                <span class="badge bg-light text-secondary border"><i class="bi bi-shield-check me-1"></i> Identity & Google OAuth</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js CDN for visual analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Auto-initialize Bootstrap Toasts
        document.addEventListener('DOMContentLoaded', function () {
            var toastElList = [].slice.call(document.querySelectorAll('.toast'));
            var toastList = toastElList.map(function (toastEl) {
                var toast = new bootstrap.Toast(toastEl);
                toast.show();
                return toast;
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
