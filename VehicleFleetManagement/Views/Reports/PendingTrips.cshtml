@model VehicleFleetManagement.ViewModels.TripsReportViewModel
@{
    ViewData["Title"] = "Pending & Scheduled Trips Dispatch Report";
    DateTime? fromDate = ViewBag.FromDate as DateTime?;
    DateTime? toDate = ViewBag.ToDate as DateTime?;

    int assignedVehiclesCount = Model.Trips.Select(t => t.VehicleId).Distinct().Count();
    int assignedDriversCount = Model.Trips.Select(t => t.DriverId).Distinct().Count();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Reports Directory
        </a>
        <h2 class="fw-bold mb-1 mt-1" style="color: #172554;">
            <i class="bi bi-clock-history text-warning me-2"></i>Pending & Scheduled Trips Dispatch Report
        </h2>
        <p class="text-muted small mb-0">Operational queue of scheduled trips awaiting departure authorization</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Trips" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Schedule New Trip
        </a>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <button type="button" class="btn btn-outline-success btn-sm" onclick="exportTableToCSV('Pending_Trips_Report.csv')">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
    </div>
</div>

<!-- Date Filter Form -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="PendingTrips" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">From Departure Date</label>
                <input type="date" name="fromDate" value="@(fromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">To Departure Date</label>
                <input type="date" name="toDate" value="@(toDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-warning text-dark btn-sm flex-grow-1">
                    <i class="bi bi-filter me-1"></i> Filter Queue
                </button>
                <a asp-action="PendingTrips" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Metrics Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="text-muted small fw-semibold text-uppercase">Pending Departures</div>
            <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalCount Trips</div>
            <div class="small text-muted mt-1">Awaiting dispatch start</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="text-muted small fw-semibold text-uppercase">Assigned Vehicles</div>
            <div class="fs-4 fw-bold text-primary mt-1">@assignedVehiclesCount Assets</div>
            <div class="small text-muted mt-1">Earmarked for departure</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-secondary border-4">
            <div class="text-muted small fw-semibold text-uppercase">Scheduled Drivers</div>
            <div class="fs-4 fw-bold text-dark mt-1">@assignedDriversCount Drivers</div>
            <div class="small text-muted mt-1">Designated for upcoming routes</div>
        </div>
    </div>
</div>

<!-- Pending Trips Table -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-table me-2 text-warning"></i>Scheduled Trips Dispatch Queue
        </h5>
        <span class="badge bg-light text-secondary border">@Model.TotalCount Trips Scheduled</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="reportTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Trip Route</th>
                        <th>Assigned Vehicle</th>
                        <th>Designated Driver</th>
                        <th>Scheduled Departure</th>
                        <th>Expected Arrival</th>
                        <th class="text-end">Start Odometer</th>
                        <th>Mission Purpose</th>
                        <th class="text-center pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Trips.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-check2-circle fs-1 text-success d-block mb-2"></i>
                                No pending or scheduled trips found in dispatch queue.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in Model.Trips)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@t.Source <i class="bi bi-arrow-right text-primary mx-1"></i> @t.Destination</div>
                                    <small class="text-muted">Trip #@t.TripId</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@t.Vehicle?.VehicleName</div>
                                    <span class="badge bg-dark small">@t.Vehicle?.RegistrationNumber</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@t.Driver?.FullName</div>
                                    <small class="text-muted">@t.Driver?.PhoneNumber</small>
                                </td>
                                <td class="small fw-semibold text-dark">
                                    @t.StartDate.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="small text-muted">
                                    @t.ExpectedEndDate.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="text-end small">
                                    @t.StartOdometer.ToString("N0") km
                                </td>
                                <td class="small text-muted">
                                    @t.Purpose
                                </td>
                                <td class="text-center pe-3">
                                    <a asp-controller="Trips" asp-action="Details" asp-route-id="@t.TripId" class="btn btn-outline-primary btn-sm py-0 px-2">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function exportTableToCSV(filename) {
            var csv = [];
            var rows = document.querySelectorAll("#reportTable tr");
            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll("td, th");
                for (var j = 0; j < cols.length; j++) 
                    row.push('"' + cols[j].innerText.replace(/"/g, '""').trim() + '"');
                csv.push(row.join(","));
            }
            var csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
            var downloadLink = document.createElement("a");
            downloadLink.download = filename;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
