@model VehicleFleetManagement.ViewModels.MonthlyFuelExpensesReportViewModel
@{
    ViewData["Title"] = $"Monthly Fuel Expenses Report ({Model.SelectedYear})";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Reports Directory
        </a>
        <h2 class="fw-bold mb-1 mt-1" style="color: #172554;">
            <i class="bi bi-fuel-pump-fill text-danger me-2"></i>Monthly Fuel Expenses Audit Report (@Model.SelectedYear)
        </h2>
        <p class="text-muted small mb-0">Fiscal breakdown of fleet fuel procurement, volume pumped, and weighted average pricing</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <form method="get" asp-action="MonthlyFuelExpenses" class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 fw-semibold text-muted small">Fiscal Year:</label>
            <select name="year" class="form-select form-select-sm" onchange="this.form.submit()" style="width: 110px;">
                @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 4; y--)
                {
                    if (y == Model.SelectedYear)
                    {
                        <option value="@y" selected>@y</option>
                    }
                    else
                    {
                        <option value="@y">@y</option>
                    }
                }
            </select>
        </form>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <button type="button" class="btn btn-outline-success btn-sm" onclick="exportTableToCSV('Monthly_Fuel_Expenses_@(Model.SelectedYear).csv')">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
    </div>
</div>

<!-- Annual Metrics Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-danger border-4">
            <div class="text-muted small fw-semibold text-uppercase">Annual Fuel Expense</div>
            <div class="fs-4 fw-bold text-danger mt-1">$@Model.AnnualTotalCost.ToString("N2")</div>
            <div class="small text-muted mt-1">Cumulative budgetary outlay</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="text-muted small fw-semibold text-uppercase">Annual Volume</div>
            <div class="fs-4 fw-bold text-primary mt-1">@Model.AnnualTotalLitres.ToString("N1") L</div>
            <div class="small text-muted mt-1">Total litres pumped</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="text-muted small fw-semibold text-uppercase">Total Refill Visits</div>
            <div class="fs-4 fw-bold text-dark mt-1">@Model.AnnualRefillCount</div>
            <div class="small text-muted mt-1">Fuel transactions logged</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-info border-4">
            <div class="text-muted small fw-semibold text-uppercase">Weighted Average</div>
            <div class="fs-4 fw-bold text-dark mt-1">$@Model.AveragePricePerLitre.ToString("N2") / L</div>
            <div class="small text-muted mt-1">Effective cost per litre</div>
        </div>
    </div>
</div>

<!-- Chart.js Trend: Monthly Expenditure -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-graph-up text-danger me-2"></i>Monthly Fuel Expenditure Trajectory ($)
        </h6>
    </div>
    <div class="card-body p-3">
        <div style="height: 240px; width: 100%;">
            <canvas id="monthlyFuelChart"></canvas>
        </div>
    </div>
</div>

<!-- Monthly Table -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-table me-2 text-danger"></i>Monthly Consumption & Expense Breakdown
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="reportTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Month</th>
                        <th class="text-center">Refill Count</th>
                        <th class="text-end">Volume Pumped (L)</th>
                        <th class="text-end">Avg Price / L</th>
                        <th class="text-end">Total Expenditure ($)</th>
                        <th style="width: 25%;" class="pe-3">Annual Share</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.MonthlySummaries)
                    {
                        var share = Model.AnnualTotalCost > 0 ? (m.TotalCost / Model.AnnualTotalCost) * 100 : 0;
                        <tr class="@(m.RefillCount > 0 ? "" : "text-muted opacity-75")">
                            <td class="ps-3 fw-bold">
                                <span class="badge bg-light text-dark border me-2">@m.Month.ToString("D2")</span>
                                @m.MonthName
                            </td>
                            <td class="text-center">
                                @if (m.RefillCount > 0)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-semibold px-2 py-1">@m.RefillCount refills</span>
                                }
                                else
                                {
                                    <span class="text-muted small">&mdash;</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">
                                @(m.TotalQuantity > 0 ? $"{m.TotalQuantity:N1} L" : "0.0 L")
                            </td>
                            <td class="text-end">
                                @(m.AveragePricePerLitre > 0 ? $"${m.AveragePricePerLitre:N2}" : "—")
                            </td>
                            <td class="text-end fw-bold text-danger fs-6">
                                $@m.TotalCost.ToString("N2")
                            </td>
                            <td class="pe-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-danger" role="progressbar" style="width: @share%" aria-valuenow="@share" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="small fw-semibold" style="min-width: 45px;">@share.ToString("0.0")%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light border-top border-2 fw-bold">
                    <tr>
                        <td class="ps-3">Fiscal Total</td>
                        <td class="text-center">@Model.AnnualRefillCount</td>
                        <td class="text-end">@Model.AnnualTotalLitres.ToString("N1") L</td>
                        <td class="text-end">$@Model.AveragePricePerLitre.ToString("N2")</td>
                        <td class="text-end text-danger fs-5">$@Model.AnnualTotalCost.ToString("N2")</td>
                        <td class="pe-3">100.0%</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            var monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySummaries.Select(m => m.MonthName)));
            var costData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySummaries.Select(m => m.TotalCost)));

            var ctx = document.getElementById('monthlyFuelChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: monthLabels,
                    datasets: [{
                        label: 'Monthly Fuel Outlay ($)',
                        data: costData,
                        fill: true,
                        backgroundColor: 'rgba(239, 68, 68, 0.1)',
                        borderColor: '#EF4444',
                        tension: 0.3,
                        pointBackgroundColor: '#EF4444',
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) { return '$' + value; }
                            }
                        }
                    }
                }
            });
        });

        function exportTableToCSV(filename) {
            var csv = [];
            var rows = document.querySelectorAll("#reportTable tr");
            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll("td, th");
                for (var j = 0; j < cols.length; j++) 
                    row.push('"' + cols[j].innerText.replace(/"/g, '""').trim() + '"');
                csv.push(row.join(","));
            }
            var csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
            var downloadLink = document.createElement("a");
            downloadLink.download = filename;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
