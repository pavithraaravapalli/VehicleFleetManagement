@model IEnumerable<VehicleFleetManagement.ViewModels.MaintenanceExpenseReportViewModel>
@{
    ViewData["Title"] = "Maintenance & Servicing Expenses Audit Report";
    DateTime? fromDate = ViewBag.FromDate as DateTime?;
    DateTime? toDate = ViewBag.ToDate as DateTime?;
    var vehiclesList = ViewBag.VehiclesList as SelectList;
    int? selectedVehicleId = ViewBag.SelectedVehicleId as int?;

    decimal totalCost = Model.Sum(m => m.TotalExpense);
    int totalVisits = Model.Sum(m => m.ServiceCount);
    decimal avgCostPerService = totalVisits > 0 ? totalCost / totalVisits : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Reports Directory
        </a>
        <h2 class="fw-bold mb-1 mt-1" style="color: #172554;">
            <i class="bi bi-tools text-secondary me-2"></i>Maintenance & Servicing Expenses Audit Report
        </h2>
        <p class="text-muted small mb-0">Financial audit of workshop repair invoices, routine preventive servicing, and garage charges</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <button type="button" class="btn btn-outline-success btn-sm" onclick="exportTableToCSV('Maintenance_Expenses_Report.csv')">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
    </div>
</div>

<!-- Filters Form -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="MaintenanceExpenses" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Filter by Vehicle</label>
                <select name="vehicleId" class="form-select form-select-sm" asp-items="vehiclesList">
                    <option value="">-- All Fleet Vehicles --</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">From Service Date</label>
                <input type="date" name="fromDate" value="@(fromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">To Service Date</label>
                <input type="date" name="toDate" value="@(toDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm flex-grow-1">
                    <i class="bi bi-filter me-1"></i> Apply Filter
                </button>
                <a asp-action="MaintenanceExpenses" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Summary Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-secondary border-4">
            <div class="text-muted small fw-semibold text-uppercase">Total Maintenance Invoices</div>
            <div class="fs-4 fw-bold text-dark mt-1">$@totalCost.ToString("N2")</div>
            <div class="small text-muted mt-1">Cumulative workshop repair costs</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="text-muted small fw-semibold text-uppercase">Total Service Visits</div>
            <div class="fs-4 fw-bold text-primary mt-1">@totalVisits Services</div>
            <div class="small text-muted mt-1">Preventive and corrective garage visits</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="text-muted small fw-semibold text-uppercase">Mean Cost Per Service</div>
            <div class="fs-4 fw-bold text-dark mt-1">$@avgCostPerService.ToString("N2")</div>
            <div class="small text-muted mt-1">Average invoice per maintenance event</div>
        </div>
    </div>
</div>

<!-- Maintenance Breakdown Table -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-table me-2 text-secondary"></i>Vehicle Maintenance Expense Summary
        </h5>
        <span class="badge bg-light text-secondary border">@Model.Count() Assets Tracked</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="reportTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Vehicle Details</th>
                        <th class="text-center">Service Visits</th>
                        <th class="text-end">Average Cost / Visit</th>
                        <th class="text-end">Total Expenditure ($)</th>
                        <th style="width: 25%;" class="pe-3">Maintenance Share</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 text-secondary d-block mb-2"></i>
                                No maintenance records found matching selected filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var v in Model)
                        {
                            var share = totalCost > 0 ? (v.TotalExpense / totalCost) * 100 : 0;
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@v.VehicleName</div>
                                    <span class="badge bg-dark small">@v.RegistrationNumber</span>
                                </td>
                                <td class="text-center fw-semibold">
                                    @v.ServiceCount
                                </td>
                                <td class="text-end">
                                    $@v.AverageServiceExpense.ToString("N2")
                                </td>
                                <td class="text-end fw-bold text-dark fs-6">
                                    $@v.TotalExpense.ToString("N2")
                                </td>
                                <td class="pe-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar bg-secondary" role="progressbar" style="width: @share%" aria-valuenow="@share" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="small fw-semibold" style="min-width: 45px;">@share.ToString("0.0")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-light border-top border-2 fw-bold">
                    <tr>
                        <td class="ps-3">Total Fleet Expenditure</td>
                        <td class="text-center">@totalVisits</td>
                        <td class="text-end">$@avgCostPerService.ToString("N2")</td>
                        <td class="text-end fs-5 text-dark">$@totalCost.ToString("N2")</td>
                        <td class="pe-3">100.0%</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function exportTableToCSV(filename) {
            var csv = [];
            var rows = document.querySelectorAll("#reportTable tr");
            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll("td, th");
                for (var j = 0; j < cols.length; j++) 
                    row.push('"' + cols[j].innerText.replace(/"/g, '""').trim() + '"');
                csv.push(row.join(","));
            }
            var csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
            var downloadLink = document.createElement("a");
            downloadLink.download = filename;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
