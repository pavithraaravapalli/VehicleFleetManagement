@model IEnumerable<VehicleFleetManagement.ViewModels.FuelConsumptionReportViewModel>
@{
    ViewData["Title"] = "Vehicle Fuel Consumption & Mileage Efficiency Report";
    DateTime? fromDate = ViewBag.FromDate as DateTime?;
    DateTime? toDate = ViewBag.ToDate as DateTime?;
    var vehiclesList = ViewBag.VehiclesList as SelectList;
    int? selectedVehicleId = ViewBag.SelectedVehicleId as int?;

    decimal totalCost = Model.Sum(m => m.TotalFuelCost);
    decimal totalLitres = Model.Sum(m => m.TotalLitres);
    int totalRefills = Model.Sum(m => m.RefillCount);
    var mileageList = Model.Where(m => m.AverageMileageKmPerLitre > 0).ToList();
    decimal meanMileage = mileageList.Any() ? Math.Round(mileageList.Average(m => m.AverageMileageKmPerLitre), 1) : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Reports Directory
        </a>
        <h2 class="fw-bold mb-1 mt-1" style="color: #172554;">
            <i class="bi bi-droplet-half text-success me-2"></i>Vehicle Fuel Consumption & Mileage Efficiency Report
        </h2>
        <p class="text-muted small mb-0">Per-vehicle fuel procurement volumes, fiscal expenditure, and real-world mileage (km/L)</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <button type="button" class="btn btn-outline-success btn-sm" onclick="exportTableToCSV('Fuel_Consumption_Mileage_Report.csv')">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
    </div>
</div>

<!-- Filters Form -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="FuelConsumption" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Filter by Vehicle</label>
                <select name="vehicleId" class="form-select form-select-sm" asp-items="vehiclesList">
                    <option value="">-- All Fleet Vehicles --</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">From Refill Date</label>
                <input type="date" name="fromDate" value="@(fromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">To Refill Date</label>
                <input type="date" name="toDate" value="@(toDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn text-white btn-sm flex-grow-1" style="background-color: var(--fleet-primary);">
                    <i class="bi bi-filter me-1"></i> Apply Filter
                </button>
                <a asp-action="FuelConsumption" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-success border-4">
            <div class="text-muted small fw-semibold text-uppercase">Total Fuel Expenses</div>
            <div class="fs-4 fw-bold text-success mt-1">$@totalCost.ToString("N2")</div>
            <div class="small text-muted mt-1">Direct fuel purchase outlay</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="text-muted small fw-semibold text-uppercase">Total Litres Consumed</div>
            <div class="fs-4 fw-bold text-primary mt-1">@totalLitres.ToString("N1") L</div>
            <div class="small text-muted mt-1">Fleet volume pumped</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-info border-4">
            <div class="text-muted small fw-semibold text-uppercase">Refill Receipts</div>
            <div class="fs-4 fw-bold text-dark mt-1">@totalRefills</div>
            <div class="small text-muted mt-1">Pump transactions logged</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="text-muted small fw-semibold text-uppercase">Fleet Average Mileage</div>
            <div class="fs-4 fw-bold text-dark mt-1">@(meanMileage > 0 ? $"{meanMileage:N1} km/L" : "N/A")</div>
            <div class="small text-muted mt-1">Effective fleet economy</div>
        </div>
    </div>
</div>

<!-- Chart.js Fuel Consumption Volume per Vehicle -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-bar-chart-fill text-success me-2"></i>Fuel Volume Consumed by Vehicle (Litres)
        </h6>
    </div>
    <div class="card-body p-3">
        <div style="height: 240px; width: 100%;">
            <canvas id="fuelVolumeChart"></canvas>
        </div>
    </div>
</div>

<!-- Consumption Table -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-table me-2 text-success"></i>Vehicle Fuel Consumption Breakdown
        </h5>
        <span class="badge bg-light text-secondary border">@Model.Count() Vehicles</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="reportTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Vehicle Details</th>
                        <th>Fuel Type</th>
                        <th class="text-center">Refill Count</th>
                        <th class="text-end">Volume Pumped (L)</th>
                        <th class="text-end">Average Price / L</th>
                        <th class="text-end">Total Fuel Cost ($)</th>
                        <th class="text-center pe-3">Mileage Efficiency</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 text-secondary d-block mb-2"></i>
                                No fuel consumption records found matching selected filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@v.VehicleName</div>
                                    <span class="badge bg-dark small">@v.RegistrationNumber</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@v.FuelType</span>
                                </td>
                                <td class="text-center fw-semibold">
                                    @v.RefillCount
                                </td>
                                <td class="text-end fw-semibold">
                                    @v.TotalLitres.ToString("N1") L
                                </td>
                                <td class="text-end">
                                    @(v.AveragePricePerLitre > 0 ? $"${v.AveragePricePerLitre:N2}" : "—")
                                </td>
                                <td class="text-end fw-bold text-success fs-6">
                                    $@v.TotalFuelCost.ToString("N2")
                                </td>
                                <td class="text-center pe-3">
                                    @if (v.AverageMileageKmPerLitre > 0)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2 fs-6">
                                            @v.AverageMileageKmPerLitre.ToString("N1") km/L
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Requires 2+ logs</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-light border-top border-2 fw-bold">
                    <tr>
                        <td class="ps-3">Fleet Aggregate</td>
                        <td>—</td>
                        <td class="text-center">@totalRefills</td>
                        <td class="text-end">@totalLitres.ToString("N1") L</td>
                        <td class="text-end">—</td>
                        <td class="text-end text-success fs-5">$@totalCost.ToString("N2")</td>
                        <td class="text-center pe-3">@(meanMileage > 0 ? $"{meanMileage:N1} km/L" : "—")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => $"{m.VehicleName} ({m.RegistrationNumber})")));
            var volumes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.TotalLitres)));

            var ctx = document.getElementById('fuelVolumeChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total Fuel Volume (Litres)',
                        data: volumes,
                        backgroundColor: 'rgba(16, 185, 129, 0.75)',
                        borderColor: '#10B981',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) { return value + ' L'; }
                            }
                        }
                    }
                }
            });
        });

        function exportTableToCSV(filename) {
            var csv = [];
            var rows = document.querySelectorAll("#reportTable tr");
            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll("td, th");
                for (var j = 0; j < cols.length; j++) 
                    row.push('"' + cols[j].innerText.replace(/"/g, '""').trim() + '"');
                csv.push(row.join(","));
            }
            var csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
            var downloadLink = document.createElement("a");
            downloadLink.download = filename;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
