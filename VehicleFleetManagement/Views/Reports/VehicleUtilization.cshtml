@model IEnumerable<VehicleFleetManagement.ViewModels.VehicleUtilizationReportViewModel>
@{
    ViewData["Title"] = "Vehicle Utilization & Asset Efficiency Report";
    DateTime? fromDate = ViewBag.FromDate as DateTime?;
    DateTime? toDate = ViewBag.ToDate as DateTime?;

    decimal totalFleetKm = Model.Sum(m => m.TotalDistanceKm);
    int totalCompleted = Model.Sum(m => m.CompletedTrips);
    var topVehicle = Model.OrderByDescending(m => m.UtilizationPercentage).FirstOrDefault();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Reports Directory
        </a>
        <h2 class="fw-bold mb-1 mt-1" style="color: #172554;">
            <i class="bi bi-speedometer text-primary me-2"></i>Vehicle Utilization & Asset Efficiency Report
        </h2>
        <p class="text-muted small mb-0">Telemetry of vehicle road time, distance traversed, and asset operational frequency</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
        <button type="button" class="btn btn-outline-success btn-sm" onclick="exportTableToCSV('Vehicle_Utilization_Report.csv')">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
    </div>
</div>

<!-- Date Filter Form -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="VehicleUtilization" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">From Start Date</label>
                <input type="date" name="fromDate" value="@(fromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">To End Date</label>
                <input type="date" name="toDate" value="@(toDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                    <i class="bi bi-filter me-1"></i> Apply Filter
                </button>
                <a asp-action="VehicleUtilization" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Utilization KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="text-muted small fw-semibold text-uppercase">Total Fleet Distance</div>
            <div class="fs-4 fw-bold text-dark mt-1">@totalFleetKm.ToString("N1") km</div>
            <div class="small text-muted mt-1">Cumulative distance logged across fleet</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-success border-4">
            <div class="text-muted small fw-semibold text-uppercase">Completed Missions</div>
            <div class="fs-4 fw-bold text-success mt-1">@totalCompleted Trips</div>
            <div class="small text-muted mt-1">Total successfully concluded journeys</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="text-muted small fw-semibold text-uppercase">Highest Utilization Asset</div>
            <div class="fs-5 fw-bold text-dark mt-1">@(topVehicle?.VehicleName ?? "N/A")</div>
            <div class="small text-muted mt-1">@(topVehicle?.UtilizationPercentage.ToString("0.0") ?? "0")% active road frequency</div>
        </div>
    </div>
</div>

<!-- Chart.js Visualization of Distance Traversed per Vehicle -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-bar-chart-fill text-primary me-2"></i>Total Distance Traversed by Vehicle (km)
        </h6>
    </div>
    <div class="card-body p-3">
        <div style="height: 240px; width: 100%;">
            <canvas id="utilizationChart"></canvas>
        </div>
    </div>
</div>

<!-- Utilization Records Table -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-table me-2 text-primary"></i>Vehicle Utilization Audit Data
        </h5>
        <span class="badge bg-light text-secondary border">@Model.Count() Vehicles Evaluated</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="reportTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Vehicle Details</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th class="text-center">Total Trips</th>
                        <th class="text-center">Completed</th>
                        <th class="text-end">Distance Logged</th>
                        <th class="text-end">Current Odometer</th>
                        <th class="text-center">Active Days</th>
                        <th style="width: 20%;" class="pe-3">Utilization Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 text-secondary d-block mb-2"></i>
                                No vehicle utilization data found for the selected period.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            string statusBadge = item.CurrentStatus switch
                            {
                                "Available" => "bg-success",
                                "Assigned" => "bg-warning text-dark",
                                "UnderMaintenance" => "bg-danger",
                                _ => "bg-secondary"
                            };

                            string progressColor = item.UtilizationPercentage switch
                            {
                                >= 70 => "bg-success",
                                >= 40 => "bg-primary",
                                >= 20 => "bg-warning",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@item.VehicleName</div>
                                    <span class="badge bg-dark px-2 py-1 small">@item.RegistrationNumber</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.VehicleType</span>
                                </td>
                                <td>
                                    <span class="badge @statusBadge">@item.CurrentStatus</span>
                                </td>
                                <td class="text-center fw-semibold">@item.TotalTrips</td>
                                <td class="text-center text-success fw-bold">@item.CompletedTrips</td>
                                <td class="text-end fw-bold text-dark">@item.TotalDistanceKm.ToString("N1") km</td>
                                <td class="text-end small text-muted">@item.CurrentOdometer.ToString("N0") km</td>
                                <td class="text-center fw-semibold">@item.ActiveDaysInPeriod days</td>
                                <td class="pe-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar @progressColor" role="progressbar" style="width: @item.UtilizationPercentage%" aria-valuenow="@item.UtilizationPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="small fw-bold" style="min-width: 45px;">@item.UtilizationPercentage%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => $"{m.VehicleName} ({m.RegistrationNumber})")));
            var distances = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.TotalDistanceKm)));

            var ctx = document.getElementById('utilizationChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total Distance Driven (km)',
                        data: distances,
                        backgroundColor: 'rgba(13, 148, 136, 0.75)',
                        borderColor: '#0D9488',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) { return value + ' km'; }
                            }
                        }
                    }
                }
            });
        });

        function exportTableToCSV(filename) {
            var csv = [];
            var rows = document.querySelectorAll("#reportTable tr");
            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll("td, th");
                for (var j = 0; j < cols.length; j++) 
                    row.push('"' + cols[j].innerText.replace(/"/g, '""').trim() + '"');
                csv.push(row.join(","));
            }
            var csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
            var downloadLink = document.createElement("a");
            downloadLink.download = filename;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
