@model IEnumerable<VehicleFleetManagement.ViewModels.DriverTripHistoryReportViewModel>
@{
    ViewData["Title"] = "Driver Assignment & Performance History Report";
    DateTime? fromDate = ViewBag.FromDate as DateTime?;
    DateTime? toDate = ViewBag.ToDate as DateTime?;
    var driversList = ViewBag.DriversList as SelectList;
    int? selectedDriverId = ViewBag.SelectedDriverId as int?;

    int totalMissions = Model.Sum(m => m.TotalAssignedTrips);
    decimal totalDistance = Model.Sum(m => m.TotalDistanceDrivenKm);
    int totalCompleted = Model.Sum(m => m.CompletedTrips);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Reports Directory
        </a>
        <h2 class="fw-bold mb-1 mt-1" style="color: #172554;">
            <i class="bi bi-person-lines-fill text-success me-2"></i>Driver Assignment & Performance History
        </h2>
        <p class="text-muted small mb-0">Audit log of assigned missions, completed dispatches, and total kilometers driven</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
        <button type="button" class="btn btn-outline-success btn-sm" onclick="exportTableToCSV('Driver_Trip_History.csv')">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
    </div>
</div>

<!-- Filters Form -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="DriverTripHistory" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Filter by Driver</label>
                <select name="driverId" class="form-select form-select-sm" asp-items="driversList">
                    <option value="">-- All Fleet Drivers --</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">From Date</label>
                <input type="date" name="fromDate" value="@(fromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">To Date</label>
                <input type="date" name="toDate" value="@(toDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-success btn-sm flex-grow-1">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
                <a asp-action="DriverTripHistory" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Summary Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-success border-4">
            <div class="text-muted small fw-semibold text-uppercase">Total Distance Logged</div>
            <div class="fs-4 fw-bold text-dark mt-1">@totalDistance.ToString("N1") km</div>
            <div class="small text-muted mt-1">Driven by assigned workforce</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="text-muted small fw-semibold text-uppercase">Total Assigned Missions</div>
            <div class="fs-4 fw-bold text-dark mt-1">@totalMissions Trips</div>
            <div class="small text-muted mt-1">Scheduled or executed journeys</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-custom p-3 border-start border-info border-4">
            <div class="text-muted small fw-semibold text-uppercase">Completed Missions</div>
            <div class="fs-4 fw-bold text-info mt-1">@totalCompleted Trips</div>
            <div class="small text-muted mt-1">Concluded without cancellation</div>
        </div>
    </div>
</div>

<!-- Driver Performance Table -->
<div class="card card-custom shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-table me-2 text-success"></i>Driver Performance Records
        </h5>
        <span class="badge bg-light text-secondary border">@Model.Count() Drivers</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="reportTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Driver Name</th>
                        <th>License Number</th>
                        <th>Contact</th>
                        <th>Availability</th>
                        <th class="text-center">Total Trips</th>
                        <th class="text-center text-success">Completed</th>
                        <th class="text-center text-primary">In Progress</th>
                        <th class="text-center text-danger">Cancelled</th>
                        <th class="text-end pe-3">Distance Driven</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 text-secondary d-block mb-2"></i>
                                No driver trip records found matching filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var d in Model)
                        {
                            string badgeClass = d.AvailabilityStatus switch
                            {
                                "Available" => "bg-success",
                                "OnTrip" => "bg-primary",
                                "Inactive" => "bg-danger",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="ps-3 fw-bold text-dark">
                                    <i class="bi bi-person-circle text-muted me-1"></i>@d.FullName
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@d.LicenseNumber</span>
                                </td>
                                <td class="small text-muted">@d.PhoneNumber</td>
                                <td>
                                    <span class="badge @badgeClass">@d.AvailabilityStatus</span>
                                </td>
                                <td class="text-center fw-bold">@d.TotalAssignedTrips</td>
                                <td class="text-center text-success fw-bold">@d.CompletedTrips</td>
                                <td class="text-center text-primary fw-bold">@d.InProgressTrips</td>
                                <td class="text-center text-danger">@d.CancelledTrips</td>
                                <td class="text-end pe-3 fw-bold text-dark">@d.TotalDistanceDrivenKm.ToString("N1") km</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function exportTableToCSV(filename) {
            var csv = [];
            var rows = document.querySelectorAll("#reportTable tr");
            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll("td, th");
                for (var j = 0; j < cols.length; j++) 
                    row.push('"' + cols[j].innerText.replace(/"/g, '""').trim() + '"');
                csv.push(row.join(","));
            }
            var csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
            var downloadLink = document.createElement("a");
            downloadLink.download = filename;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
