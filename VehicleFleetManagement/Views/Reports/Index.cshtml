@model VehicleFleetManagement.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Executive Fleet Reports & Business Intelligence";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: #172554;">
            <i class="bi bi-graph-up-arrow text-primary me-2"></i>Executive Fleet Reports & Business Intelligence
        </h2>
        <p class="text-muted small mb-0">Centralized audit analytics, asset utilization metrics, and financial expenditure reports</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Dashboard" asp-action="Admin" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Operations Dashboard
        </a>
        <button type="button" class="btn btn-outline-primary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Summary
        </button>
    </div>
</div>

<!-- Financial & Asset KPI Highlights -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card card-custom p-3 border-start border-primary border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Total Fleet Assets</div>
            <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalVehicles Vehicles</div>
            <div class="small text-muted mt-1">@Model.AvailableVehicles Available | @Model.AssignedVehicles Busy</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card card-custom p-3 border-start border-success border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Trip Volume</div>
            <div class="fs-4 fw-bold text-success mt-1">@Model.TotalTrips Trips</div>
            <div class="small text-muted mt-1">@Model.CompletedTrips Completed</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card card-custom p-3 border-start border-warning border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Fuel Expenditure</div>
            <div class="fs-4 fw-bold text-warning mt-1">$@Model.TotalFuelExpenses.ToString("N2")</div>
            <div class="small text-muted mt-1">Fleet Fuel Costs</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card card-custom p-3 border-start border-danger border-4 h-100">
            <div class="text-muted small fw-semibold text-uppercase">Maintenance Costs</div>
            <div class="fs-4 fw-bold text-danger mt-1">$@Model.TotalMaintenanceExpenses.ToString("N2")</div>
            <div class="small text-muted mt-1">Garage & Servicing Invoices</div>
        </div>
    </div>
</div>

<!-- Report Modules Directory Grid -->
<div class="row g-4">
    <!-- 1. Vehicle Utilization Report -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card card-custom h-100 shadow-sm border-0 transition-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 me-3">
                        <i class="bi bi-speedometer fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Vehicle Utilization</h5>
                        <span class="badge bg-light text-primary border">Asset Efficiency</span>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Analyze vehicle road time, total distance logged, active operational days, and percentage utilization rates across the fleet.
                </p>
                <a asp-action="VehicleUtilization" class="btn btn-outline-primary w-100 mt-2">
                    <i class="bi bi-eye me-1"></i> View Utilization Report
                </a>
            </div>
        </div>
    </div>

    <!-- 2. Driver Trip History -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card card-custom h-100 shadow-sm border-0 transition-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 me-3">
                        <i class="bi bi-person-lines-fill fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Driver Trip History</h5>
                        <span class="badge bg-light text-success border">Workforce Performance</span>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Review individual driver dispatches, completed missions, journey distances, and performance accountability records.
                </p>
                <a asp-action="DriverTripHistory" class="btn btn-outline-success w-100 mt-2">
                    <i class="bi bi-eye me-1"></i> View Driver Report
                </a>
            </div>
        </div>
    </div>

    <!-- 3. Completed Trips -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card card-custom h-100 shadow-sm border-0 transition-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-info bg-opacity-10 text-info rounded-3 me-3">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Completed Trips</h5>
                        <span class="badge bg-light text-info border">Journey Audit</span>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Audited registry of all completed missions with verified start/end odometer readings, routes, and total distances travelled.
                </p>
                <a asp-action="CompletedTrips" class="btn btn-outline-info w-100 mt-2">
                    <i class="bi bi-eye me-1"></i> View Completed Trips
                </a>
            </div>
        </div>
    </div>

    <!-- 4. Pending & Scheduled Trips -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card card-custom h-100 shadow-sm border-0 transition-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3 me-3">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Pending & Scheduled Trips</h5>
                        <span class="badge bg-light text-warning border">Dispatch Pipeline</span>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Upcoming scheduled itineraries awaiting driver departure, route origins, destinations, and assigned assets.
                </p>
                <a asp-action="PendingTrips" class="btn btn-outline-warning text-dark w-100 mt-2">
                    <i class="bi bi-eye me-1"></i> View Pending Trips
                </a>
            </div>
        </div>
    </div>

    <!-- 5. Monthly Fuel Expenses -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card card-custom h-100 shadow-sm border-0 transition-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3 me-3">
                        <i class="bi bi-fuel-pump-fill fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Monthly Fuel Expenses</h5>
                        <span class="badge bg-light text-danger border">Fiscal Audit</span>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Aggregated month-by-month fuel consumption, total budgetary expenditure, transaction counts, and average purchase prices per litre.
                </p>
                <a asp-action="MonthlyFuelExpenses" class="btn btn-outline-danger w-100 mt-2">
                    <i class="bi bi-eye me-1"></i> View Monthly Fuel Report
                </a>
            </div>
        </div>
    </div>

    <!-- 6. Maintenance Expenses -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card card-custom h-100 shadow-sm border-0 transition-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-secondary bg-opacity-10 text-secondary rounded-3 me-3">
                        <i class="bi bi-tools fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Maintenance Expenses</h5>
                        <span class="badge bg-light text-secondary border">Garage Servicing</span>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Detailed analysis of fleet workshop invoices, preventive service charges, repair records, and cumulative maintenance overhead.
                </p>
                <a asp-action="MaintenanceExpenses" class="btn btn-outline-secondary w-100 mt-2">
                    <i class="bi bi-eye me-1"></i> View Maintenance Report
                </a>
            </div>
        </div>
    </div>

    <!-- 7. Fuel Consumption & Mileage Analysis -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card card-custom h-100 shadow-sm border-0 transition-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 text-white rounded-3 me-3" style="background-color: var(--fleet-primary);">
                        <i class="bi bi-droplet-half fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Fuel Consumption & Mileage</h5>
                        <span class="badge bg-light text-primary border">Efficiency (km/L)</span>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Per-vehicle fuel consumption volumes, refill frequencies, total fuel expenditures, and computed real-world mileage efficiencies.
                </p>
                <a asp-action="FuelConsumption" class="btn text-white w-100 mt-2" style="background-color: var(--fleet-primary);">
                    <i class="bi bi-eye me-1"></i> View Consumption Report
                </a>
            </div>
        </div>
    </div>
</div>
