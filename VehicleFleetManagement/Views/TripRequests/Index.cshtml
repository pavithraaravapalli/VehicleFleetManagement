@model IEnumerable<VehicleFleetManagement.Models.TripRequest>
@{
    ViewData["Title"] = "My Transport Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--fleet-navy);">
            <i class="bi bi-clock-history me-2" style="color: var(--fleet-primary);"></i>My Transport Requests
        </h2>
        <p class="text-muted small mb-0">Track official vehicle booking requests, review statuses, and view assigned fleet dispatches.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center shadow-sm px-3 py-2" style="background-color: var(--fleet-primary); border-color: var(--fleet-primary);">
        <i class="bi bi-plus-circle me-2"></i> Submit New Request
    </a>
</div>

@if (!Model.Any())
{
    <div class="card-modern p-5 text-center my-4">
        <div class="avatar-placeholder mx-auto mb-3" style="width: 64px; height: 64px; background-color: var(--fleet-primary-light); color: var(--fleet-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.75rem;">
            <i class="bi bi-clipboard2-plus"></i>
        </div>
        <h5 class="fw-bold text-dark">No Transport Requests Found</h5>
        <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
            You have not submitted any vehicle booking requests yet. Once submitted, fleet administrators will review, assign a vehicle and driver, and dispatch your journey.
        </p>
        <a asp-action="Create" class="btn btn-primary px-4 py-2" style="background-color: var(--fleet-primary); border-color: var(--fleet-primary);">
            <i class="bi bi-send-plus me-2"></i> Book Transport Now
        </a>
    </div>
}
else
{
    <div class="card-modern">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Request #</th>
                        <th>Route</th>
                        <th>Departure & Return</th>
                        <th>Passengers</th>
                        <th>Status</th>
                        <th>Assigned Trip</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">
                                #@item.TripRequestId
                                <div class="text-muted small" style="font-size: 0.72rem;">@item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>@item.Source
                                </div>
                                <div class="text-muted small">
                                    <i class="bi bi-arrow-down-short text-secondary me-1"></i>
                                    <i class="bi bi-flag-fill text-primary me-1"></i>@item.Destination
                                </div>
                            </td>
                            <td>
                                <div class="small fw-medium text-dark">
                                    @item.StartDate.ToString("MMM dd, yyyy HH:mm")
                                </div>
                                <div class="small text-muted">
                                    To: @item.EstimatedEndDate.ToString("MMM dd, yyyy HH:mm")
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-people-fill me-1 text-secondary"></i>@item.PassengerCount
                                </span>
                                @if (!string.IsNullOrEmpty(item.PreferredVehicleType) && item.PreferredVehicleType != "Any")
                                {
                                    <div class="small text-muted" style="font-size: 0.72rem;">Pref: @item.PreferredVehicleType</div>
                                }
                            </td>
                            <td>
                                @if (item.Status == VehicleFleetManagement.Models.TripRequestStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>Pending Review</span>
                                }
                                else if (item.Status == VehicleFleetManagement.Models.TripRequestStatus.Approved)
                                {
                                    <span class="badge bg-primary px-2 py-1"><i class="bi bi-check2-circle me-1"></i>Approved</span>
                                }
                                else if (item.Status == VehicleFleetManagement.Models.TripRequestStatus.Rejected)
                                {
                                    <span class="badge bg-danger px-2 py-1"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2 py-1">@item.Status</span>
                                }
                            </td>
                            <td>
                                @if (item.ApprovedTripId.HasValue && item.ApprovedTrip != null)
                                {
                                    <a asp-controller="Trips" asp-action="Details" asp-route-id="@item.ApprovedTripId" class="badge bg-light text-primary border text-decoration-none py-1 px-2">
                                        <i class="bi bi-signpost-2 me-1"></i>Trip #@item.ApprovedTripId.Value
                                    </a>
                                    @if (item.ApprovedTrip.Vehicle != null)
                                    {
                                        <div class="small text-muted" style="font-size: 0.72rem;">@item.ApprovedTrip.Vehicle.VehicleName</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Not assigned</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.TripRequestId" class="btn btn-sm btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (item.Status == VehicleFleetManagement.Models.TripRequestStatus.Pending)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@item.TripRequestId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this booking request?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel Request">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
