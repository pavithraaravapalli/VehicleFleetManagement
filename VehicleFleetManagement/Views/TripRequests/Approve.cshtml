@model VehicleFleetManagement.ViewModels.ApproveTripRequestViewModel
@{
    ViewData["Title"] = $"Approve Request #{Model.TripRequestId}";
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Manage" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h3 class="fw-bold mb-1" style="color: var(--fleet-navy);">
                    <i class="bi bi-shield-check me-2" style="color: var(--fleet-primary);"></i>Approve Request & Dispatch Fleet
                </h3>
                <p class="text-muted small mb-0">Assign an available fleet asset and qualified driver to fulfill this staff transportation request.</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left: Request Summary Card -->
            <div class="col-md-5">
                <div class="card-modern p-4 h-100">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-primary">Request #@Model.TripRequestId</span>
                        <span class="text-muted small">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>

                    <h5 class="fw-bold text-dark mb-1">@Model.RequesterName</h5>
                    <p class="text-muted small mb-3">@Model.RequesterEmail</p>

                    <div class="border rounded p-3 mb-3 bg-light">
                        <div class="mb-2">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Origin</span>
                            <span class="fw-semibold text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.Source</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Destination</span>
                            <span class="fw-semibold text-dark"><i class="bi bi-flag-fill text-primary me-1"></i>@Model.Destination</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Departure Date</span>
                            <span class="small text-dark fw-medium">@Model.StartDate.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold d-block">Estimated Return</span>
                            <span class="small text-dark fw-medium">@Model.EstimatedEndDate.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-muted small d-block">Passengers</span>
                            <span class="fw-bold text-dark">@Model.PassengerCount People</span>
                        </div>
                        <div class="text-end">
                            <span class="text-muted small d-block">Preference</span>
                            <span class="badge bg-light text-secondary border">@(string.IsNullOrEmpty(Model.PreferredVehicleType) ? "Any" : Model.PreferredVehicleType)</span>
                        </div>
                    </div>

                    <div>
                        <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Official Purpose</span>
                        <p class="small text-muted fst-italic mb-0 bg-white p-2 rounded border">"@Model.Purpose"</p>
                    </div>
                </div>
            </div>

            <!-- Right: Assignment Form -->
            <div class="col-md-7">
                <div class="card-modern p-4">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-truck-front text-primary me-2"></i>Resource Assignment
                    </h5>

                    <form asp-action="Approve" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TripRequestId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                        <!-- Select Vehicle -->
                        <div class="mb-3">
                            <label asp-for="SelectedVehicleId" class="form-label small fw-semibold text-dark"></label>
                            @if (Model.AvailableVehicles != null && Model.AvailableVehicles.Any())
                            {
                                <select asp-for="SelectedVehicleId" asp-items="Model.AvailableVehicles" class="form-select">
                                    <option value="">-- Choose an Available Fleet Vehicle --</option>
                                </select>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 small mb-0">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> No vehicles are currently marked as Available. Please check vehicle inventory or maintenance logs.
                                </div>
                            }
                            <span asp-validation-for="SelectedVehicleId" class="text-danger small"></span>
                        </div>

                        <!-- Select Driver -->
                        <div class="mb-3">
                            <label asp-for="SelectedDriverId" class="form-label small fw-semibold text-dark"></label>
                            @if (Model.AvailableDrivers != null && Model.AvailableDrivers.Any())
                            {
                                <select asp-for="SelectedDriverId" asp-items="Model.AvailableDrivers" class="form-select">
                                    <option value="">-- Choose an Available Driver --</option>
                                </select>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 small mb-0">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> No drivers are currently available for assignment. Please review driver statuses.
                                </div>
                            }
                            <span asp-validation-for="SelectedDriverId" class="text-danger small"></span>
                        </div>

                        <!-- Admin Notes -->
                        <div class="mb-4">
                            <label asp-for="AdminNotes" class="form-label small fw-semibold text-dark"></label>
                            <textarea asp-for="AdminNotes" rows="3" class="form-control" placeholder="Optional dispatch instructions or notes for driver and passenger (e.g. Fuel card issued, Gate pass ready)."></textarea>
                            <span asp-validation-for="AdminNotes" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Manage" class="btn btn-outline-secondary px-3">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm" style="background-color: var(--fleet-primary); border-color: var(--fleet-primary);" @((Model.AvailableVehicles == null || !Model.AvailableVehicles.Any() || Model.AvailableDrivers == null || !Model.AvailableDrivers.Any()) ? "disabled" : "")>
                                <i class="bi bi-check2-circle me-1"></i> Confirm & Dispatch Journey
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
